# Indicators page (/indicators). On Supabase Edge Functions the four SUPABASE_* values are provided automatically.
SUPABASE_URL=https://<project>.supabase.co          # Project Settings → API → Project URL
SUPABASE_ANON_KEY=...                               # Project Settings → API → anon public key (verifies who's signed in)
SUPABASE_SERVICE_ROLE_KEY=...                       # Project Settings → API → service_role key. SERVER ONLY. Signs "storage:" download links
SUPABASE_DB_URL=postgres://...                      # Project Settings → Database → Connection string
SITE_URL=https://vtimpact.com                       # allowed origin for the API (CORS)
INDICATORS_MEMBERS_REQUIRE_SUBSCRIPTION=false       # true = "members" indicators need an active Instant Impact subscription, not just an account
