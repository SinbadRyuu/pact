# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase Postgres (Project Settings -> Connect -> Connection string) ---
# Pooled "Transaction" connection string (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Direct "Session" connection string (port 5432) — used only when running migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- Supabase API keys (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server-only key, never exposed to the browser. Used by admin API routes to read/write Storage.
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Admin access ---
# Comma-separated list of email addresses allowed into /admin, checked against
# whoever Supabase Auth says is logged in. Add/remove people here, no code change.
ADMIN_EMAILS="you@example.com,li@example.com,mal@example.com"

# --- Telegram (set these once the bot exists; leave blank until then) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
