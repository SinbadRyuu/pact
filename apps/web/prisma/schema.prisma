// Prisma schema for the PACT onboarding system.
// Target: Supabase Postgres. Run `npm run db:migrate` from the repo root after
// DATABASE_URL is set in apps/web/.env.local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (via Supabase's pgbouncer) — used at runtime.
  url       = env("DATABASE_URL")
  // Direct connection — used only for migrations, which pgbouncer can't handle reliably.
  directUrl = env("DIRECT_URL")
}

enum OnboardingStatus {
  STARTED
  AWAITING_BROKER_SIGNUP
  ACCOUNT_CREATED
  KYC_PENDING
  KYC_COMPLETE
  DEPOSIT_PENDING
  DEPOSIT_SUBMITTED
  APPROVED
  REJECTED
  COMPLETED
}

/// A broker/IB route a user can be onboarded through. Admin-manageable so a
/// second broker, or a changed link/minimum deposit, is a data change, not a
/// code change or redeploy.
model Broker {
  id                 String   @id @default(cuid())
  name               String
  signupUrl          String
  minDepositAmount   Int
  minDepositCurrency String   @default("£")
  isActive           Boolean  @default(true)
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions OnboardingSession[]

  @@index([isActive])
}

/// One onboarding journey for one prospective user. Deliberately holds only
/// what onboarding/verification actually needs — no extra personal data.
model OnboardingSession {
  id     String           @id @default(cuid())
  status OnboardingStatus @default(STARTED)

  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id])

  /// Freeform name/handle the user gives us, optional, for admin identification only.
  displayName           String?
  contactHandle         String?
  depositAmountClaimed  Decimal? @db.Decimal(12, 2)
  /// Storage reference (path/key) to the uploaded screenshot — never raw bytes in the DB.
  depositScreenshotRef  String?
  rejectionReason       String?
  referralCode          String?

  notes         AdminNote[]
  statusHistory StatusHistoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Internal admin notes on a session — never shown to the user.
model AdminNote {
  id          String   @id @default(cuid())
  sessionId   String
  session     OnboardingSession @relation(fields: [sessionId], references: [id])
  authorEmail String
  body        String
  createdAt   DateTime @default(now())

  @@index([sessionId])
}

/// Append-only audit trail of every status change, for basic logging /
/// "what happened if something goes wrong".
model StatusHistoryEntry {
  id         String            @id @default(cuid())
  sessionId  String
  session    OnboardingSession @relation(fields: [sessionId], references: [id])
  fromStatus OnboardingStatus?
  toStatus   OnboardingStatus
  /// "user" | "admin:<email>" | "system"
  actor      String
  createdAt  DateTime @default(now())

  @@index([sessionId])
}
