# Automation page (/automation). Copy the lines you need into the server's env (Supabase: `supabase secrets set …`,
# Vercel: Settings → Environment Variables). Never commit real values.

# --- Stripe (start with TEST mode values) ---
STRIPE_SECRET_KEY=sk_test_...                 # Stripe Dashboard → Developers → API keys → Secret key
STRIPE_WEBHOOK_SECRET=whsec_...               # Developers → Webhooks → your endpoint → Signing secret (or `stripe listen` output locally)
STRIPE_PRICE_INSTANT_IMPACT=price_...         # Product catalog → Instant Impact → the $9.99/month price → Price ID
SITE_URL=https://vtimpact.com                 # used for Checkout / Portal return links (http://localhost:5173 locally)

# --- Instant Impact ---
TELEGRAM_SIGNALS_LINK=https://t.me/+...       # Telegram → private channel → Invite link (only shown to subscribers)
INSTANT_IMPACT_CHANNEL_ID=                    # optional: only show signals from this Trade Room channel id
INSTANT_IMPACT_GRACE_DAYS=0                   # optional: days of access kept after a failed payment

# --- The Sniper Bot ---
VT_MARKETS_SIGNUP_LINK=https://...            # VT Markets IB portal → your referral link
SNIPER_BOT_COPY_LINK=https://...              # VT Markets app → Copy Trading → The Sniper Bot → Share (web link)
SNIPER_BOT_APP_LINK=                          # optional: app deep link to the same listing (ask your VT Markets IB manager)
VT_MARKETS_ANDROID_PACKAGE=                   # optional: VT Markets Android package name, for a reliable app-or-web open on Android
CRUCIAL_MARKETS_LINK=https://...              # Crucial Markets referral link for US clients

# --- Provided automatically on Supabase Edge Functions (only set these yourself elsewhere) ---
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_DB_URL=postgres://...
