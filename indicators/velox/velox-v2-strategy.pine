targetRR    = input.float(2.0, "Single target (R)", minval = 0.5, maxval = 5.0, step = 0.5, group = grpLab, tooltip = "Research 1, 1.5, 2, 2.5 and 3. Look for a stable area, not one magic value.")
riskCash    = input.float(100, "Risk per trade (account currency)", minval = 1, step = 10, group = grpLab, tooltip = "Size = this ÷ stop distance, rounded to whole ounces. With 100, net profit ÷ 100 ≈ net R.")
maxHold     = input.int(48, "Close after (candles, 0 = off)", minval = 0, maxval = 2000, group = grpLab)
flatWeekend = input.bool(true, "Flat before the weekend (Fri 15:00 New York)", group = grpLab)
showTrades  = input.bool(true, "Draw trades (entry, SL, target)", group = grpLab)
keepTrades  = input.int(10, "Trades drawn", minval = 1, maxval = 50, group = grpLab)
showLab     = input.bool(true, "Show research table", group = grpLab)
labPos      = input.string("Top right", "Table position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = grpLab)

