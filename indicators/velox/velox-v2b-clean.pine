//@version=6
strategy("Velox V2B.2 — Clean Supply & Demand Lab", "Velox V2B.2", overlay = true, pyramiding = 0, initial_capital = 1000000, margin_long = 100, margin_short = 100, commission_type = strategy.commission.percent, commission_value = 0.01, slippage = 1, process_orders_on_close = false, calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// PACT Finance — clean-room Phase 1 research strategy.
// Purpose: test the CORE supply/demand entry idea without partial exits, break-even logic,
// order-block scoring, breaker trades, or other layers that can hide whether the basic entry has edge.
// This is research code, not financial advice and not a claim of profitability.
// Syntax-reviewed; TradingView's compiler was not run outside TradingView.
//
// V2B.2 changes from V2B.1:
//  - Higher timeframe is Auto by default (1m→15m, 5m→1H, 15m/1H→4H, 4H→D, D→W): no more stop on the 4H chart.
//  - Zone ATR is read from the real candle history (V2B.1 read the history of a function argument, which
//    only advances when the function is called, so the zone's ATR could come from the wrong candle).
//  - Trade boxes stop at the exit instead of extending right forever.
//  - Compact dashboard (size, position and detail are inputs).

// Explicitly reserve enough history for time conversions in bar-index drawings.
max_bars_back(time, 3500)

// ═════════════════════════════ Inputs ═════════════════════════════

grpCore = "Core supply & demand"
swingLen = input.int(10, "Swing length", minval = 2, maxval = 50, group = grpCore)
atrLen = input.int(14, "ATR length", minval = 2, maxval = 100, group = grpCore)
bosBufATR = input.float(0.10, "BOS close buffer (ATR)", minval = 0.0, step = 0.05, group = grpCore)
zoneMinDisp = input.float(1.50, "Minimum departure (ATR)", minval = 0.25, step = 0.25, group = grpCore)
zoneMinH = input.float(0.15, "Minimum zone height (ATR)", minval = 0.05, step = 0.05, group = grpCore)
zoneMaxH = input.float(1.00, "Maximum zone height (ATR)", minval = 0.10, step = 0.10, group = grpCore)
speedZeroBars = input.int(20, "Departure speed zero-score bars", minval = 2, maxval = 200, group = grpCore)
maxZones = input.int(100, "Maximum live zones kept", minval = 10, maxval = 300, group = grpCore)
showPerSide = input.int(2, "Zones displayed per side", minval = 1, maxval = 5, group = grpCore)

grpLife = "Zone lifecycle"
touchExitATR = input.float(0.50, "Leave distance before a new visit (ATR)", minval = 0.0, step = 0.10, group = grpLife)
mitigationDepth = input.float(0.50, "Mitigated at depth", minval = 0.10, maxval = 1.00, step = 0.10, group = grpLife)
invalidationBufATR = input.float(0.00, "Close invalidation buffer (ATR)", minval = 0.0, step = 0.05, group = grpLife)
showMitigated = input.bool(true, "Show mitigated zones", group = grpLife)

grpTrade = "Phase 1 entry test"
targetR = input.float(2.00, "Target (R)", minval = 0.50, maxval = 5.00, step = 0.50, group = grpTrade)
minStrength = input.int(65, "Minimum zone strength", minval = 0, maxval = 100, group = grpTrade)
armBars = input.int(3, "Reject within bars of first touch", minval = 0, maxval = 10, group = grpTrade)
maxZoneAge = input.int(200, "Maximum zone age (bars)", minval = 10, maxval = 2000, group = grpTrade)
rejectBodyATR = input.float(0.20, "Rejection body minimum (ATR)", minval = 0.0, step = 0.05, group = grpTrade)
rejectBodyRatio = input.float(0.55, "Rejection body / range minimum", minval = 0.0, maxval = 1.0, step = 0.05, group = grpTrade)
rejectCloseLoc = input.float(0.70, "Long close location / mirrored short", minval = 0.50, maxval = 1.00, step = 0.05, group = grpTrade)
slBufATR = input.float(0.10, "Stop beyond distal edge (ATR)", minval = 0.0, step = 0.05, group = grpTrade)
minRiskATR = input.float(0.50, "Minimum stop distance (ATR)", minval = 0.05, step = 0.05, group = grpTrade)
maxRiskATR = input.float(1.50, "Maximum stop distance (ATR)", minval = 0.10, step = 0.10, group = grpTrade)
minRoomR = input.float(1.75, "Minimum room to opposing zone (R)", minval = 0.0, step = 0.25, group = grpTrade)
riskCash = input.float(100.0, "Planned cash risk per trade", minval = 1.0, step = 10.0, group = grpTrade)
requireChartTrend = input.bool(true, "Require chart structure alignment", group = grpTrade)
requireHtfTrend = input.bool(true, "Require confirmed HTF structure alignment", group = grpTrade)

grpHtf = "Higher timeframe"
htfMode = input.string("Auto", "Higher timeframe", options = ["Auto", "Manual"], group = grpHtf, tooltip = "Auto: 1m → 15m, 5m → 1H, 15m and 1H → 4H, 4H → Daily, Daily → Weekly.")
htfManual = input.timeframe("240", "Manual timeframe", group = grpHtf, tooltip = "Used only in Manual mode. If it is not higher than the chart, the HTF filter is switched off instead of stopping the script.")

grpSession = "Sessions"
useSessionFilter = input.bool(true, "Only London / NY sessions on 1H and below", group = grpSession)
londonSession = input.session("0700-1000", "London", group = grpSession)
nyAmSession = input.session("0830-1100", "New York AM", group = grpSession)
nyPmSession = input.session("1330-1600", "New York PM", group = grpSession)
showSessionShade = input.bool(true, "Shade active sessions", group = grpSession)

grpTest = "Test window"
testStart = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Test from", group = grpTest)
testEnd = input.time(timestamp("31 Dec 2030 23:59 +0000"), "Test to", group = grpTest)

grpVisual = "Visuals"
showStructure = input.bool(true, "Show BOS / CHoCH", group = grpVisual)
showTradePlan = input.bool(true, "Show entry / TP / SL boxes", group = grpVisual)
keepTrades = input.int(10, "Trades drawn", minval = 1, maxval = 50, group = grpVisual)

grpDash = "Dashboard"
showDashboard = input.bool(true, "Show dashboard", group = grpDash)
dashDetail = input.bool(false, "Detailed (all research rows)", group = grpDash, tooltip = "Off: trades, win %, net R and profit factor only.")
dashSize = input.string("Tiny", "Text size", options = ["Tiny", "Small", "Normal"], group = grpDash)
dashPos = input.string("Top right", "Position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = grpDash)

// ═════════════════════════════ Safety and timeframes ═════════════════════════════

if barstate.isfirst and not chart.is_standard
    runtime.error("Velox Clean Lab requires standard candles/bars. Do not backtest it on Heikin Ashi, Renko, Range, Kagi or other synthetic prices.")

chartSec = timeframe.in_seconds()
autoHtf = chartSec <= 60 ? "15" : chartSec <= 300 ? "60" : chartSec <= 3600 ? "240" : chartSec <= 14400 ? "D" : "W"
htfTf = htfMode == "Auto" ? autoHtf : htfManual
htfUsable = timeframe.in_seconds(htfTf) > chartSec

atr = ta.atr(atrLen)

// ═════════════════════════════ Types ═════════════════════════════

type Zone
    bool bull
    float top
    float bottom
    int originBar
    int confirmBar
    float atrOrigin
    float baseStrength
    int strength
    string status
    int touches
    bool inside
    int touchBar
    bool traded

// ═════════════════════════════ Helpers ═════════════════════════════

clamp01(float x) =>
    math.max(0.0, math.min(1.0, x))

fmt(float x) =>
    str.tostring(x, format.mintick)

tfName(int sec) =>
    sec % 604800 == 0 ? "W" : sec % 86400 == 0 ? "D" : sec % 3600 == 0 ? str.tostring(sec / 3600) + "H" : str.tostring(sec / 60) + "m"

currentStrength(Zone z) =>
    float life = z.status == "fresh" ? 20.0 : z.status == "tested" ? 10.0 : 0.0
    int(math.round(math.min(100.0, z.baseStrength + life)))

zoneExists(array<Zone> zs, bool bull, int originBar) =>
    bool found = false
    if zs.size() > 0
        for z in zs
            if z.bull == bull and z.originBar == originBar
                found := true
    found

// Demand: the lowest low between the broken swing high and the breaking candle (supply mirrored).
buildZone(bool bull, int swingBar) =>
    int fromBar = math.max(swingBar + 1, bar_index - 499)
    int originBar = fromBar
    if fromBar <= bar_index
        for j = fromBar to bar_index
            int off = bar_index - j
            int originOff = bar_index - originBar
            bool moreExtreme = bull ? low[off] < low[originOff] : high[off] > high[originOff]
            if moreExtreme
                originBar := j
    int oOff = bar_index - originBar
    float originAtr = atr[oOff]
    float far = bull ? low[oOff] : high[oOff]
    float near = bull ? math.min(open[oOff], close[oOff]) : math.max(open[oOff], close[oOff])
    float sign = bull ? 1.0 : -1.0
    float height = sign * (near - far)
    if not na(originAtr) and originAtr > 0
        if height < zoneMinH * originAtr
            near := far + sign * zoneMinH * originAtr
        if height > zoneMaxH * originAtr
            near := far + sign * zoneMaxH * originAtr
    float top = math.max(near, far)
    float bottom = math.min(near, far)
    float displacement = not na(originAtr) and originAtr > 0 ? sign * (close - near) / originAtr : na
    int elapsed = math.max(0, bar_index - originBar - 1)
    float dispScore = not na(displacement) ? 40.0 * clamp01(displacement / (2.0 * zoneMinDisp)) : 0.0
    float speedScore = 20.0 * clamp01(1.0 - float(elapsed) / float(speedZeroBars))
    float baseStrength = 20.0 + dispScore + speedScore
    Zone result = na
    if not na(originAtr) and originAtr > 0 and not na(displacement) and displacement >= zoneMinDisp
        result := Zone.new(bull, math.round_to_mintick(top), math.round_to_mintick(bottom), originBar, bar_index, originAtr, baseStrength, int(math.round(math.min(100.0, baseStrength + 20.0))), "fresh", 0, false, na, false)
    result

roomToOpposing(array<Zone> zs, bool bull, float entry) =>
    float room = na
    if zs.size() > 0
        for z in zs
            bool live = z.status == "fresh" or z.status == "tested"
            if live and z.bull != bull
                float edge = bull ? z.bottom : z.top
                float dist = bull ? edge - entry : entry - edge
                if dist > 0 and (na(room) or dist < room)
                    room := dist
    room

nearestIndexes(array<Zone> zs, bool bull, int wanted) =>
    array<int> out = array.new<int>()
    for slot = 1 to wanted
        int best = -1
        float bestDist = 1e20
        if zs.size() > 0
            for i = 0 to zs.size() - 1
                Zone z = zs.get(i)
                bool visible = z.status == "fresh" or z.status == "tested" or (showMitigated and z.status == "mitigated")
                if visible and z.bull == bull and not out.includes(i)
                    float mid = (z.top + z.bottom) * 0.5
                    float dist = math.abs(close - mid)
                    if dist < bestDist
                        best := i
                        bestDist := dist
        if best >= 0
            out.push(best)
    out

htfTrendEngine() =>
    float a = ta.atr(atrLen)
    float ph = ta.pivothigh(high, swingLen, swingLen)
    float pl = ta.pivotlow(low, swingLen, swingLen)
    var float sh = na
    var float sl = na
    var bool shBroken = true
    var bool slBroken = true
    var int tr = 0
    if not na(ph)
        sh := ph
        shBroken := false
    if not na(pl)
        sl := pl
        slBroken := false
    bool up = not shBroken and not na(sh) and not na(a) and close > sh + bosBufATR * a
    bool down = not slBroken and not na(sl) and not na(a) and close < sl - bosBufATR * a
    if up and down
        up := false
        down := false
    if up
        shBroken := true
        tr := 1
    if down
        slBroken := true
        tr := -1
    tr

// ═════════════════════════════ Core state ═════════════════════════════

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float swingHigh = na
var int swingHighBar = na
var bool swingHighBroken = true
var float swingLow = na
var int swingLowBar = na
var bool swingLowBroken = true
var int chartTrend = 0
var array<Zone> zones = array.new<Zone>()

if barstate.isconfirmed
    if not na(ph)
        swingHigh := ph
        swingHighBar := bar_index - swingLen
        swingHighBroken := false
    if not na(pl)
        swingLow := pl
        swingLowBar := bar_index - swingLen
        swingLowBroken := false

    bool bullBreak = not swingHighBroken and not na(swingHigh) and not na(atr) and close > swingHigh + bosBufATR * atr
    bool bearBreak = not swingLowBroken and not na(swingLow) and not na(atr) and close < swingLow - bosBufATR * atr

    if bullBreak and bearBreak
        bullBreak := false
        bearBreak := false

    if bullBreak
        bool choch = chartTrend < 0
        swingHighBroken := true
        Zone newZone = buildZone(true, swingHighBar)
        if not na(newZone) and not zoneExists(zones, true, newZone.originBar)
            zones.push(newZone)
        if showStructure
            line.new(math.max(swingHighBar, bar_index - 3000), swingHigh, bar_index, swingHigh, xloc = xloc.bar_index, color = color.new(color.aqua, 0), style = choch ? line.style_dashed : line.style_solid)
            label.new(bar_index, swingHigh, choch ? "CHoCH" : "BOS", xloc = xloc.bar_index, style = label.style_label_down, color = color.new(color.black, 100), textcolor = color.aqua, size = size.tiny)
        chartTrend := 1

    if bearBreak
        bool choch = chartTrend > 0
        swingLowBroken := true
        Zone newZone = buildZone(false, swingLowBar)
        if not na(newZone) and not zoneExists(zones, false, newZone.originBar)
            zones.push(newZone)
        if showStructure
            line.new(math.max(swingLowBar, bar_index - 3000), swingLow, bar_index, swingLow, xloc = xloc.bar_index, color = color.new(color.red, 0), style = choch ? line.style_dashed : line.style_solid)
            label.new(bar_index, swingLow, choch ? "CHoCH" : "BOS", xloc = xloc.bar_index, style = label.style_label_up, color = color.new(color.black, 100), textcolor = color.red, size = size.tiny)
        chartTrend := -1

    if zones.size() > 0
        for i = zones.size() - 1 to 0
            Zone z = zones.get(i)
            if z.confirmBar < bar_index
                float sign = z.bull ? 1.0 : -1.0
                float near = z.bull ? z.top : z.bottom
                float far = z.bull ? z.bottom : z.top
                float reach = z.bull ? low : high
                if z.inside and sign * (reach - near) > touchExitATR * z.atrOrigin
                    z.inside := false
                if not z.inside and sign * (reach - near) <= 0
                    z.inside := true
                    z.touches += 1
                    z.touchBar := bar_index
                    if z.status == "fresh"
                        z.status := "tested"
                float depth = near - sign * mitigationDepth * (z.top - z.bottom)
                if (z.status == "fresh" or z.status == "tested") and sign * (reach - depth) <= 0
                    z.status := "mitigated"
                float invalidLevel = far - sign * invalidationBufATR * z.atrOrigin
                if sign * (close - invalidLevel) < 0
                    z.status := "invalid"
                z.strength := currentStrength(z)
            bool tooOldToKeep = bar_index - z.confirmBar > 2000
            if z.status == "invalid" or tooOldToKeep
                zones.remove(i)

    while zones.size() > maxZones
        zones.shift()

// Previous CLOSED higher-timeframe candle only ([1] + lookahead_on): no repainting.
htfTrend = request.security(syminfo.tickerid, htfTf, htfTrendEngine()[1], lookahead = barmerge.lookahead_on)

// ═════════════════════════════ Sessions ═════════════════════════════

inLondon = not na(time(timeframe.period, londonSession, "Europe/London"))
inNyAm = not na(time(timeframe.period, nyAmSession, "America/New_York"))
inNyPm = not na(time(timeframe.period, nyPmSession, "America/New_York"))
inKillzone = inLondon or inNyAm or inNyPm
sessionOk = not useSessionFilter or chartSec > 3600 or inKillzone

color sessionShade = na
if showSessionShade and chartSec <= 3600
    if inLondon
        sessionShade := color.new(color.aqua, 92)
    else if inNyAm
        sessionShade := color.new(color.orange, 92)
    else if inNyPm
        sessionShade := color.new(color.blue, 93)
bgcolor(sessionShade)

// ═════════════════════════════ Trade result bookkeeping ═════════════════════════════

var float signalClose = na
var float signalStop = na
var float signalTarget = na
var float plannedRiskPrice = na
var bool signalBull = false
var int signalZoneStrength = na
var int signalZoneAge = na
var string signalSession = ""

var int statTrades = 0
var int statWins = 0
var int statLongs = 0
var int statShorts = 0
var float statNetR = 0.0
var float statWinR = 0.0
var float statLossR = 0.0
var float statMfeR = 0.0
var float statMaeR = 0.0
var float statGapR = 0.0
var int statHit1 = 0
var int statHit15 = 0
var int statHit2 = 0
var int statHit25 = 0
var int statHit3 = 0
var int statLosers = 0
var int statLoserReached08 = 0
var int lossStreak = 0
var int maxLossStreak = 0
var float peakNetR = 0.0
var float maxDrawdownR = 0.0

closedDelta = ta.change(strategy.closedtrades)
closedNow = closedDelta > 0

if closedNow
    int t = strategy.closedtrades - 1
    float entryPx = strategy.closedtrades.entry_price(t)
    float exitPx = strategy.closedtrades.exit_price(t)
    float signedSize = strategy.closedtrades.size(t)
    float side = signedSize > 0 ? 1.0 : -1.0
    float qtyAbs = math.abs(signedSize)
    float riskPriceActual = not na(signalStop) ? math.abs(entryPx - signalStop) : na
    float riskCashActual = not na(riskPriceActual) ? riskPriceActual * qtyAbs * syminfo.pointvalue : na
    float grossCash = side * (exitPx - entryPx) * qtyAbs * syminfo.pointvalue
    float fees = strategy.closedtrades.commission(t)
    float netCash = grossCash - fees
    float tradeR = not na(riskCashActual) and riskCashActual > 0 ? netCash / riskCashActual : na
    float mfeR = not na(riskCashActual) and riskCashActual > 0 ? strategy.closedtrades.max_runup(t) / riskCashActual : na
    float maeR = not na(riskCashActual) and riskCashActual > 0 ? strategy.closedtrades.max_drawdown(t) / riskCashActual : na
    float gapAdverseR = not na(plannedRiskPrice) and plannedRiskPrice > 0 ? side * (entryPx - signalClose) / plannedRiskPrice : na
    if not na(tradeR)
        statTrades += 1
        statNetR += tradeR
        statMfeR += nz(mfeR)
        statMaeR += nz(maeR)
        statGapR += nz(gapAdverseR)
        if side > 0
            statLongs += 1
        else
            statShorts += 1
        if tradeR > 0
            statWins += 1
            statWinR += tradeR
            lossStreak := 0
        else
            statLossR += math.abs(tradeR)
            statLosers += 1
            lossStreak += 1
            maxLossStreak := math.max(maxLossStreak, lossStreak)
        if nz(mfeR) >= 1.0
            statHit1 += 1
        if nz(mfeR) >= 1.5
            statHit15 += 1
        if nz(mfeR) >= 2.0
            statHit2 += 1
        if nz(mfeR) >= 2.5
            statHit25 += 1
        if nz(mfeR) >= 3.0
            statHit3 += 1
        if tradeR < 0 and nz(mfeR) >= 0.8
            statLoserReached08 += 1
        peakNetR := math.max(peakNetR, statNetR)
        maxDrawdownR := math.max(maxDrawdownR, peakNetR - statNetR)
    signalClose := na
    signalStop := na
    signalTarget := na
    plannedRiskPrice := na
    signalZoneStrength := na
    signalZoneAge := na
    signalSession := ""

// ═════════════════════════════ Entry selection ═════════════════════════════

inDateRange = time >= testStart and time <= testEnd
flat = strategy.position_size == 0

if barstate.isconfirmed and inDateRange and flat and not closedNow and sessionOk and not na(atr) and atr > 0
    Zone best = na
    float bestStop = na
    float bestRisk = na
    float bestScore = na
    float candleRange = math.max(high - low, syminfo.mintick)
    float candleBody = math.abs(close - open)
    float bodyRatio = candleBody / candleRange
    float closeLoc = (close - low) / candleRange
    if zones.size() > 0
        for z in zones
            float sign = z.bull ? 1.0 : -1.0
            float near = z.bull ? z.top : z.bottom
            float far = z.bull ? z.bottom : z.top
            bool firstTouch = z.status == "tested" and z.touches == 1 and not na(z.touchBar) and bar_index - z.touchBar <= armBars
            bool ageOk = bar_index - z.confirmBar <= maxZoneAge
            bool strengthOk = z.strength >= minStrength
            bool directionOk = sign * (close - near) > 0 and sign * (close - open) > 0
            bool bodyOk = candleBody >= rejectBodyATR * atr and bodyRatio >= rejectBodyRatio
            bool locationOk = z.bull ? closeLoc >= rejectCloseLoc : closeLoc <= 1.0 - rejectCloseLoc
            bool chartTrendOk = not requireChartTrend or chartTrend == int(sign)
            bool htfTrendOk = not requireHtfTrend or not htfUsable or htfTrend == int(sign)
            float stopPx = far - sign * slBufATR * atr
            float riskPx = sign * (close - stopPx)
            bool riskOk = riskPx >= minRiskATR * atr and riskPx <= maxRiskATR * atr
            float room = roomToOpposing(zones, z.bull, close)
            bool roomOk = na(room) or (riskPx > 0 and room / riskPx >= minRoomR)
            float score = float(z.strength)
            if firstTouch and ageOk and strengthOk and directionOk and bodyOk and locationOk and chartTrendOk and htfTrendOk and riskOk and roomOk and not z.traded
                if na(bestScore) or score > bestScore
                    best := z
                    bestStop := stopPx
                    bestRisk := riskPx
                    bestScore := score
    if not na(best)
        best.traded := true
        float sign = best.bull ? 1.0 : -1.0
        float stopPx = math.round_to_mintick(bestStop)
        float targetPx = math.round_to_mintick(close + sign * targetR * bestRisk)
        float pointValue = math.max(syminfo.pointvalue, 0.0000001)
        float qty = riskCash / (bestRisk * pointValue)
        signalClose := close
        signalStop := stopPx
        signalTarget := targetPx
        plannedRiskPrice := bestRisk
        signalBull := best.bull
        signalZoneStrength := best.strength
        signalZoneAge := bar_index - best.confirmBar
        signalSession := inLondon ? "LONDON" : inNyAm ? "NY AM" : inNyPm ? "NY PM" : "OUTSIDE"
        if best.bull
            strategy.entry("L", strategy.long, qty = qty)
            strategy.exit("LX", "L", stop = stopPx, limit = targetPx)
            alert("Velox Clean LONG | entry ~" + fmt(close) + " | SL " + fmt(stopPx) + " | TP " + fmt(targetPx) + " | STR " + str.tostring(best.strength) + " | " + signalSession, alert.freq_once_per_bar_close)
        else
            strategy.entry("S", strategy.short, qty = qty)
            strategy.exit("SX", "S", stop = stopPx, limit = targetPx)
            alert("Velox Clean SHORT | entry ~" + fmt(close) + " | SL " + fmt(stopPx) + " | TP " + fmt(targetPx) + " | STR " + str.tostring(best.strength) + " | " + signalSession, alert.freq_once_per_bar_close)

if strategy.position_size > 0 and not na(signalStop) and not na(signalTarget)
    strategy.exit("LX", "L", stop = signalStop, limit = signalTarget)

if strategy.position_size < 0 and not na(signalStop) and not na(signalTarget)
    strategy.exit("SX", "S", stop = signalStop, limit = signalTarget)

if barstate.isconfirmed and time > testEnd and strategy.position_size != 0
    strategy.close_all(comment = "End of test")

// ═════════════════════════════ Trade drawings: green TP box, blue SL box, entry / TP / SL labels ═════════════════════════════

var array<box> tradeBoxes = array.new<box>()
var array<label> tradeLabels = array.new<label>()
var box curTpBox = na
var box curSlBox = na
var label curEntryLab = na
var label curTpLab = na
var label curSlLab = na

newSignal = not na(signalClose) and na(signalClose[1])

if showTradePlan and newSignal
    curTpBox := box.new(bar_index, math.max(signalClose, signalTarget), bar_index + 1, math.min(signalClose, signalTarget), xloc = xloc.bar_index, border_color = color.new(color.lime, 20), bgcolor = color.new(color.lime, 82))
    curSlBox := box.new(bar_index, math.max(signalClose, signalStop), bar_index + 1, math.min(signalClose, signalStop), xloc = xloc.bar_index, border_color = color.new(color.blue, 20), bgcolor = color.new(color.blue, 84))
    curEntryLab := label.new(bar_index + 1, signalClose, (signalBull ? "BUY ENTRY " : "SELL ENTRY ") + fmt(signalClose), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
    curTpLab := label.new(bar_index + 1, signalTarget, "TP " + fmt(signalTarget), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.lime, 30), textcolor = color.white, size = size.tiny)
    curSlLab := label.new(bar_index + 1, signalStop, "SL " + fmt(signalStop), xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.blue, 30), textcolor = color.white, size = size.tiny)
    tradeBoxes.push(curTpBox)
    tradeBoxes.push(curSlBox)
    tradeLabels.push(curEntryLab)
    tradeLabels.push(curTpLab)
    tradeLabels.push(curSlLab)
    while tradeBoxes.size() > 2 * keepTrades
        box.delete(tradeBoxes.shift())
    while tradeLabels.size() > 3 * keepTrades
        label.delete(tradeLabels.shift())

// Extend the current trade to the present candle until it closes (the signal values reset on the exit candle).
if showTradePlan and not na(signalClose) and not na(curTpBox)
    curTpBox.set_right(bar_index + 1)
    curSlBox.set_right(bar_index + 1)
    curEntryLab.set_x(bar_index + 1)
    curTpLab.set_x(bar_index + 1)
    curSlLab.set_x(bar_index + 1)

enteredDelta = ta.change(strategy.opentrades)
enteredNow = enteredDelta > 0

if showTradePlan and enteredNow and strategy.position_size != 0
    int entryBar = strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    float actualEntry = strategy.position_avg_price
    label.new(entryBar, actualEntry, "FILL " + fmt(actualEntry), xloc = xloc.bar_index, style = strategy.position_size > 0 ? label.style_label_up : label.style_label_down, color = color.new(color.yellow, 70), textcolor = color.yellow, size = size.tiny)

// ═════════════════════════════ Zone drawings ═════════════════════════════

var array<box> drawnZones = array.new<box>()

// A strategy does not run on the still-forming candle, so also draw on the last closed one.
if barstate.islast or barstate.islastconfirmedhistory
    for b in drawnZones
        b.delete()
    drawnZones.clear()
    for bull in array.from(true, false)
        array<int> ids = nearestIndexes(zones, bull, showPerSide)
        if ids.size() > 0
            for idx in ids
                Zone z = zones.get(idx)
                color c = bull ? color.aqua : color.red
                int fade = z.status == "fresh" ? 78 : z.status == "tested" ? 84 : 91
                string txt = (bull ? "DEMAND" : "SUPPLY") + " · " + str.tostring(z.strength) + " · " + z.status + " · T" + str.tostring(z.touches)
                box zb = box.new(math.max(z.originBar, bar_index - 3000), z.top, bar_index, z.bottom, xloc = xloc.bar_index, extend = extend.right, border_color = color.new(c, 25), bgcolor = color.new(c, fade), text = txt, text_color = c, text_size = size.tiny, text_halign = text.align_center)
                drawnZones.push(zb)

// ═════════════════════════════ Dashboard (compact by default) ═════════════════════════════

dashTextSize = dashSize == "Tiny" ? size.tiny : dashSize == "Small" ? size.small : size.normal
dashPosV = dashPos == "Top right" ? position.top_right : dashPos == "Bottom right" ? position.bottom_right : dashPos == "Top left" ? position.top_left : position.bottom_left
var table dash = table.new(dashPosV, 2, 14, bgcolor = color.new(color.black, 30), frame_color = color.new(color.gray, 75), frame_width = 1)

dashRow(int r, string k, string v, color c) =>
    dash.cell(0, r, k, text_color = color.silver, text_size = dashTextSize, text_halign = text.align_left)
    dash.cell(1, r, v, text_color = c, text_size = dashTextSize, text_halign = text.align_right)

pct(int n, int d) =>
    d > 0 ? str.tostring(100.0 * float(n) / float(d), "#") + "%" : "–"

if showDashboard and (barstate.islast or barstate.islastconfirmedhistory)
    float pf = statLossR > 0 ? statWinR / statLossR : na
    float avgR = statTrades > 0 ? statNetR / float(statTrades) : na
    dashRow(0, "VELOX", tfName(chartSec), color.white)
    dashRow(1, "Trades", str.tostring(statTrades), color.white)
    dashRow(2, "Win %", pct(statWins, statTrades), color.white)
    dashRow(3, "Net R", str.tostring(statNetR, "#.##"), statNetR >= 0 ? color.lime : color.red)
    dashRow(4, "PF", na(pf) ? "–" : str.tostring(pf, "#.##"), color.white)
    if dashDetail
        dashRow(5, "Avg R", na(avgR) ? "–" : str.tostring(avgR, "#.##"), color.white)
        dashRow(6, "Max DD (R)", str.tostring(maxDrawdownR, "#.##"), color.white)
        dashRow(7, "Loss streak", str.tostring(maxLossStreak), color.white)
        dashRow(8, "Avg MFE / MAE", statTrades > 0 ? str.tostring(statMfeR / statTrades, "#.##") + " / " + str.tostring(statMaeR / statTrades, "#.##") : "–", color.white)
        dashRow(9, "Hit 1R / 2R / 3R", pct(statHit1, statTrades) + " / " + pct(statHit2, statTrades) + " / " + pct(statHit3, statTrades), color.white)
        dashRow(10, "Losers hit +0.8R", pct(statLoserReached08, statLosers), color.white)
        dashRow(11, "Long / Short", str.tostring(statLongs) + " / " + str.tostring(statShorts), color.white)
        dashRow(12, "Avg fill gap (R)", statTrades > 0 ? str.tostring(statGapR / statTrades, "#.##") : "–", color.white)
        dashRow(13, "HTF " + tfName(timeframe.in_seconds(htfTf)), not htfUsable ? "off" : htfTrend > 0 ? "BULL" : htfTrend < 0 ? "BEAR" : "–", htfTrend > 0 ? color.lime : htfTrend < 0 ? color.red : color.silver)
