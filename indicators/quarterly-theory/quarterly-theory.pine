// Quarterly Theory — True Opens, quarter boxes and previous Q4 open/close.
//
// Every cycle is split into four quarters (Q1–Q4). The True Open of a cycle is the open of its
// Q2. All times are New York time, and the trading day starts at 18:00.
//
//   Cycle          Quarters                                          True open
//   Yearly         Jan–Mar | Apr–Jun | Jul–Sep | Oct–Dec               TYO  = 1 April
//   Monthly        week 1 | week 2 | week 3 | week 4 (Monday weeks)    TMO  = 2nd Monday (Sun 18:00)
//   Weekly         Mon | Tue | Wed | Thu (Friday shown on its own)     TWO  = Monday 18:00
//   Daily          Asia 18-00 | London 00-06 | NY 06-12 | PM 12-18     TDO  = 00:00
//   Session (6H)   four 90-minute quarters                             AO 19:30, LO 01:30, NYO 07:30, PMO 13:30
//   90 Minute      four 22.5-minute quarters                           T90  = start + 22.5 min
//
// Adaptive mode (default) draws only the cycle that fits the chart timeframe, e.g. on 5m you get
// the 90-minute cycle's boxes, its true open and the previous 90-minute Q4 open/close — nothing else.
//
// It describes time and price only. Nothing here is financial advice.

//@version=6
indicator("Quarterly Theory - True Opens", "QT True Opens", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────

G_GEN = "General"
mode      = input.string("Adaptive", "Mode", options = ["Adaptive", "Manual"], group = G_GEN, tooltip = "Adaptive: the chart timeframe picks ONE cycle, and only that cycle's quarter boxes, true open and previous Q4 open/close are drawn.\n1m-5m = 90 Minute\n6m-15m = Session (6H)\n16m-1H = Daily\n2H-4H = Weekly\n5H-1D = Monthly\nabove 1D = Yearly\n\nManual: every cycle switched on below is drawn, and the boxes follow 'Box cycle'.")
tz        = input.string("America/New_York", "Timezone", group = G_GEN, tooltip = "Quarterly Theory uses New York time. Leave this unless you know you need another.")
lookback  = input.int(10, "Intraday history (days)", minval = 1, maxval = 120, group = G_GEN, tooltip = "How many days back to draw the Daily, Session and 90-minute cycles and the intraday boxes. Yearly, monthly and weekly opens are always drawn.")
autoHide  = input.bool(true, "Hide cycles too small for the chart timeframe (Manual)", group = G_GEN, tooltip = "Manual mode only. For example, 90-minute cycles are hidden above 5m and Daily cycles above 1H.")

G_BOX = "Quarter boxes"
boxCycle  = input.string("Auto", "Box cycle (Manual)", options = ["Auto", "Yearly", "Monthly", "Weekly", "Daily", "Session (6H)", "90 Minute", "Off"], group = G_BOX, tooltip = "Manual mode only. Which cycle's quarters get filled boxes. Auto uses the same timeframe mapping as Adaptive mode.")
q1Col     = input.color(color.new(color.gray, 85), "Q1", inline = "qc", group = G_BOX)
q2Col     = input.color(color.new(color.green, 85), "Q2", inline = "qc", group = G_BOX)
q3Col     = input.color(color.new(color.red, 85), "Q3", inline = "qc", group = G_BOX)
q4Col     = input.color(color.new(color.blue, 85), "Q4", inline = "qc", group = G_BOX)
boxBorder = input.bool(false, "Box borders", group = G_BOX)
showV     = input.bool(true, "Full-height quarter lines", inline = "v", group = G_BOX)
vCol      = input.color(color.new(color.gray, 40), "", inline = "v", group = G_BOX)
vStyleS   = input.string("Dotted", "", options = ["Solid", "Dashed", "Dotted"], inline = "v", group = G_BOX)
showQLbl  = input.bool(true, "Quarter labels", inline = "ql", group = G_BOX)
qLblCol   = input.color(color.gray, "", inline = "ql", group = G_BOX)
showOut   = input.bool(true, "Dashed outline of the whole cycle", inline = "o", group = G_BOX)
outCol    = input.color(color.new(color.gray, 30), "", inline = "o", group = G_BOX)

G_TO = "True opens (Q2 open of each cycle)"
showTYO  = input.bool(true, "TYO  True Year Open", inline = "ty", group = G_TO)
cTYO     = input.color(#e040fb, "", inline = "ty", group = G_TO)
showTMO  = input.bool(true, "TMO  True Month Open", inline = "tm", group = G_TO)
cTMO     = input.color(#ff9800, "", inline = "tm", group = G_TO)
showTWO  = input.bool(true, "TWO  True Week Open", inline = "tw", group = G_TO)
cTWO     = input.color(#2962ff, "", inline = "tw", group = G_TO)
showTDO  = input.bool(true, "TDO  True Day Open", inline = "td", group = G_TO)
cTDO     = input.color(#00bcd4, "", inline = "td", group = G_TO)
showTSO  = input.bool(true, "AO / LO / NYO / PMO  True Session Opens", inline = "ts", group = G_TO)
cTSO     = input.color(#9e9e9e, "", inline = "ts", group = G_TO)
showT90  = input.bool(true, "T90  True 90-Minute Open", inline = "t9", group = G_TO)
cT90     = input.color(#787b86, "", inline = "t9", group = G_TO)
toWidth  = input.int(1, "Line width", minval = 1, maxval = 4, group = G_TO)
toStyleS = input.string("Dotted", "Line style", options = ["Solid", "Dashed", "Dotted"], group = G_TO)
toPrice  = input.bool(true, "Show price in labels", group = G_TO)

G_Q4 = "Previous Q4 open / close"
pq4Y      = input.bool(true, "Yearly", inline = "p1", group = G_Q4)
pq4M      = input.bool(true, "Monthly", inline = "p1", group = G_Q4)
pq4W      = input.bool(true, "Weekly", inline = "p1", group = G_Q4)
pq4D      = input.bool(true, "Daily", inline = "p2", group = G_Q4)
pq4S      = input.bool(true, "Session", inline = "p2", group = G_Q4)
pq490     = input.bool(true, "90 Min", inline = "p2", group = G_Q4, tooltip = "When a cycle ends, its Q4 open and Q4 close are drawn from the start of that Q4 across the whole next cycle. Weekly Q4 is Thursday, so the weekly Q4 close is Thursday's close.")
pq4OCol   = input.color(#ff5252, "Q4 open", inline = "pc", group = G_Q4)
pq4CCol   = input.color(#4caf50, "Q4 close", inline = "pc", group = G_Q4)
pq4StyleS = input.string("Dashed", "Line style", options = ["Solid", "Dashed", "Dotted"], group = G_Q4)

G_SMT = "SMT divergence (quarter to quarter)"
showSMT   = input.bool(true, "Show SMT divergence", group = G_SMT, tooltip = "Compares each quarter with the previous quarter of the same cycle the boxes use. Bearish SMT: your chart and a comparison symbol disagree on taking out the previous quarter's high (one does, the other does not). Bullish SMT: the same with lows. An SMT is marked when the chart disagrees with ANY of the enabled comparison symbols.")
use1      = input.bool(true, "", inline = "s1", group = G_SMT)
smt1In    = input.symbol("", "Compare 1", inline = "s1", group = G_SMT)
inv1      = input.bool(false, "Invert", inline = "s1", group = G_SMT)
use2      = input.bool(true, "", inline = "s2", group = G_SMT)
smt2In    = input.symbol("", "Compare 2", inline = "s2", group = G_SMT)
inv2      = input.bool(false, "Invert", inline = "s2", group = G_SMT)
use3      = input.bool(true, "", inline = "s3", group = G_SMT, tooltip = "Leave a symbol blank to pick automatically.\nXAUUSD: XAGUSD, XPTUSD, XCUUSD (silver, platinum, copper)\nGC: SI, PL, HG\nES: NQ, YM   NQ: ES, YM   YM: ES, NQ (micros map to micros)\nEURUSD <-> GBPUSD, BTC <-> ETH\nTick Invert for inverse pairs such as DXY.")
smt3In    = input.symbol("", "Compare 3", inline = "s3", group = G_SMT)
inv3      = input.bool(false, "Invert", inline = "s3", group = G_SMT)
smtBullC  = input.color(#4caf50, "Bullish", inline = "sc", group = G_SMT)
smtBearC  = input.color(#f44336, "Bearish", inline = "sc", group = G_SMT)
smtMin    = input.int(2, "Symbols that must disagree", minval = 1, maxval = 3, group = G_SMT, tooltip = "How many of the enabled comparison symbols must disagree with the chart before an SMT is marked. If fewer symbols are available (e.g. EURUSD only has GBPUSD), all of them must disagree.")
showSmtTbl = input.bool(true, "Show SMT check table", group = G_SMT, tooltip = "Bottom-right table showing, for the current quarter, each symbol's previous quarter high/low, this quarter's high/low so far, and whether it has taken the level. Hover any SMT label for the same numbers at that SMT.")
smtRemove = input.bool(true, "Remove an SMT if every symbol ends up agreeing later in the quarter", group = G_SMT)

G_BIAS = "Trend bias (buys or sells)"
showBias  = input.bool(true, "Show bias panel", group = G_BIAS, tooltip = "Scores four things (+1 bullish, -1 bearish each) and shows whether to look for buys or sells:\n1. Price above or below the true open of the next cycle up (e.g. the session true open on 5m)\n2. Price above or below the true open of the cycle above that (e.g. TDO on 5m)\n3. Quarter structure: the last finished quarter made a higher high and higher low (or lower high and lower low) than the one before\n4. An SMT from this quarter or the one just finished (older SMTs are ignored)\nBullish at +2 or more, bearish at -2 or less, otherwise neutral (wait).")
biasBg    = input.bool(false, "Tint chart background by bias", group = G_BIAS)
biasMarks = input.bool(true, "Mark bias changes on the chart", group = G_BIAS)
biasBullC = input.color(#4caf50, "Bullish", inline = "bc", group = G_BIAS)
biasBearC = input.color(#f44336, "Bearish", inline = "bc", group = G_BIAS)

// ───────────────────────────── Helpers ─────────────────────────────

lineStyle(string s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

vStyle    = lineStyle(vStyleS)
toStyle   = lineStyle(toStyleS)
pq4Style  = lineStyle(pq4StyleS)

fmt(string name, float p) =>
    toPrice ? name + " (" + str.tostring(p, format.mintick) + ")" : name

qColor(int q) =>
    q == 0 ? q1Col : q == 1 ? q2Col : q == 2 ? q3Col : q4Col

// ───────────────────────────── Time maths ─────────────────────────────
// Shift by 6 hours so the trading day (18:00 NY) starts at 00:00 of its own date.

int   SHIFT  = 6 * 3600000
int   s      = time + SHIFT
int   tdY    = year(s, tz)
int   tdM    = month(s, tz)
int   tdD    = dayofmonth(s, tz)
int   monIdx = (dayofweek(s, tz) + 5) % 7                     // Mon = 0 ... Sun = 6
float mins   = hour(s, tz) * 60 + minute(s, tz) + second(s, tz) / 60.0
int   dayNum = int(math.round(timestamp("UTC", tdY, tdM, tdD, 0, 0) / 86400000.0))
int   dayId  = tdY * 10000 + tdM * 100 + tdD

// Yearly
int yId = tdY
int yQ  = int((tdM - 1) / 3)
// Monthly: weeks counted by Mondays. Days before the first Monday join Q1, a 5th week joins Q4.
int lastMon = tdD - monIdx
int mId = tdY * 100 + tdM
int mQ  = lastMon <= 0 ? 0 : math.min(int((lastMon - 1) / 7), 3)
// Weekly: Mon..Thu = Q1..Q4, Friday (and weekend on 24/7 markets) = index 4
int wId = int(math.floor((dayNum + 3) / 7.0))                 // 1 Jan 1970 was a Thursday
int wQ  = math.min(monIdx, 4)
// Daily: four 6-hour sessions
int dQ  = int(mins / 360)
// Session: four 90-minute quarters
int sId = dayId * 10 + dQ
int sQ  = int((mins - dQ * 360) / 90)
string sName = dQ == 0 ? "AO" : dQ == 1 ? "LO" : dQ == 2 ? "NYO" : "PMO"
// 90 minute: four 22.5-minute quarters
int n90 = int(mins / 90)
int nId = dayId * 100 + n90
int nQ  = int((mins - n90 * 90) / 22.5)

float  tfMin   = timeframe.in_seconds() / 60.0
bool   inRange = time >= last_bar_time - lookback * 86400000
bool   adaptive = mode == "Adaptive"
// The one cycle that matches the chart timeframe
string tfCycle = tfMin <= 5 ? "90 Minute" : tfMin <= 15 ? "Session (6H)" : tfMin <= 60 ? "Daily" : tfMin <= 240 ? "Weekly" : tfMin <= 1440 ? "Monthly" : "Yearly"
bool  okY = adaptive ? tfCycle == "Yearly"       : not autoHide or tfMin <= 10080
bool  okM = adaptive ? tfCycle == "Monthly"      : not autoHide or tfMin <= 1440
bool  okW = adaptive ? tfCycle == "Weekly"       : not autoHide or tfMin <= 240
bool  okD = adaptive ? tfCycle == "Daily"        : not autoHide or tfMin <= 60
bool  okS = adaptive ? tfCycle == "Session (6H)" : not autoHide or tfMin <= 15
bool  ok9 = adaptive ? tfCycle == "90 Minute"    : not autoHide or tfMin <= 5

// ───────────────────────────── Cycle engine ─────────────────────────────

type Cycle
    string tag
    int    id
    int    q
    line   toLn
    label  toLb
    float  q4o
    float  q4c
    int    q4t
    line   po
    line   pc
    label  pol
    label  pcl
    float  toPx
    string toNm

method run(Cycle c, int id, int q, bool draw, bool showTO, string toName, color toCol, bool showPQ4) =>
    bool started  = not na(c.id)
    bool newCycle = started and id != c.id
    bool newQ     = started and (newCycle or q != c.q)

    if newCycle
        c.toLn := na
        c.toLb := na
        c.po   := na
        c.pc   := na
        c.pol  := na
        c.pcl  := na
        if draw and showPQ4 and not na(c.q4o)
            c.po  := line.new(c.q4t, c.q4o, time_close, c.q4o, xloc.bar_time, color = pq4OCol, style = pq4Style)
            c.pc  := line.new(c.q4t, c.q4c, time_close, c.q4c, xloc.bar_time, color = pq4CCol, style = pq4Style)
            c.pol := label.new(time_close, c.q4o, fmt("Prev " + c.tag + " Q4 O", c.q4o), xloc.bar_time, color = color(na), style = label.style_label_left, textcolor = pq4OCol, size = size.small)
            c.pcl := label.new(time_close, c.q4c, fmt("Prev " + c.tag + " Q4 C", c.q4c), xloc.bar_time, color = color(na), style = label.style_label_left, textcolor = pq4CCol, size = size.small)
        c.q4o := na
        c.q4c := na
        c.q4t := na
        c.toPx := na

    // Track this cycle's Q4 open and close
    if q == 3
        if newQ
            c.q4o := open
            c.q4t := time
        if not na(c.q4o)
            c.q4c := close

    // True open = first bar of Q2
    if newQ and q == 1
        c.toPx := open
        c.toNm := toName
    if newQ and q == 1 and draw and showTO
        c.toLn := line.new(time, open, time_close, open, xloc.bar_time, color = toCol, style = toStyle, width = toWidth)
        c.toLb := label.new(time_close, open, fmt(toName, open), xloc.bar_time, color = color(na), style = label.style_label_left, textcolor = toCol, size = size.small)

    // Extend live lines to the current bar until the cycle ends
    if not na(c.toLn)
        c.toLn.set_x2(time_close)
        c.toLb.set_x(time_close)
    if not na(c.po)
        c.po.set_x2(time_close)
        c.pc.set_x2(time_close)
        c.pol.set_x(time_close)
        c.pcl.set_x(time_close)

    c.id := id
    c.q  := q

var Cycle cY = Cycle.new("Y")
var Cycle cM = Cycle.new("M")
var Cycle cW = Cycle.new("W")
var Cycle cD = Cycle.new("D")
var Cycle cS = Cycle.new("Sess")
var Cycle c9 = Cycle.new("90m")

cY.run(yId,   yQ, okY,            showTYO, "TYO", cTYO, pq4Y)
cM.run(mId,   mQ, okM,            showTMO, "TMO", cTMO, pq4M)
cW.run(wId,   wQ, okW,            showTWO, "TWO", cTWO, pq4W)
cD.run(dayId, dQ, okD and inRange, showTDO, "TDO", cTDO, pq4D)
cS.run(sId,   sQ, okS and inRange, showTSO, sName, cTSO, pq4S)
c9.run(nId,   nQ, ok9 and inRange, showT90, "T90", cT90, pq490)

// ───────────────────────────── Quarter boxes ─────────────────────────────

string bc = adaptive or boxCycle == "Auto" ? tfCycle : boxCycle

int bId = switch bc
    "Yearly"       => yId
    "Monthly"      => mId
    "Weekly"       => wId
    "Daily"        => dayId
    "Session (6H)" => sId
    "90 Minute"    => nId
    => na
int bQ = switch bc
    "Yearly"       => yQ
    "Monthly"      => mQ
    "Weekly"       => wQ
    "Daily"        => dQ
    "Session (6H)" => sQ
    "90 Minute"    => nQ
    => na
bool bIntraday = bc == "Daily" or bc == "Session (6H)" or bc == "90 Minute"
bool bDraw     = not na(bId) and (inRange or not bIntraday)

type BoxState
    int   id
    int   q
    box   qb
    box   ob
    label ql

var BoxState bs = BoxState.new()

if bDraw
    bool nc = na(bs.id) or bId != bs.id
    bool nq = nc or bQ != bs.q
    if nq
        color qc = qColor(bQ)
        bs.qb := box.new(time, high, time_close, low, xloc = xloc.bar_time, border_color = boxBorder ? color.new(qc, 40) : color(na), bgcolor = qc)
        if showV
            line.new(time, low, time, high, xloc.bar_time, extend.both, vCol, vStyle)
        string qName = bc == "Weekly" and bQ == 4 ? "Fri" : "Q" + str.tostring(bQ + 1)
        bs.ql := showQLbl ? label.new(time, high, qName, xloc.bar_time, color = color(na), style = label.style_label_lower_left, textcolor = qLblCol, size = size.small) : na
    else
        bs.qb.set_top(math.max(bs.qb.get_top(), high))
        bs.qb.set_bottom(math.min(bs.qb.get_bottom(), low))
        bs.qb.set_right(time_close)
        if not na(bs.ql)
            bs.ql.set_y(bs.qb.get_top())
    if showOut
        if nc
            bs.ob := box.new(time, high, time_close, low, xloc = xloc.bar_time, border_color = outCol, border_style = line.style_dashed, bgcolor = color(na))
        else if not na(bs.ob)
            bs.ob.set_top(math.max(bs.ob.get_top(), high))
            bs.ob.set_bottom(math.min(bs.ob.get_bottom(), low))
            bs.ob.set_right(time_close)
    bs.id := bId
    bs.q  := bQ

// ───────────────────────────── SMT divergence ─────────────────────────────

autoPairs() =>
    string r  = syminfo.root
    string k  = syminfo.ticker
    string a1 = "CME_MINI:NQ1!"
    string a2 = ""
    string a3 = ""
    if k == "XAUUSD"
        a1 := "OANDA:XAGUSD"
        a2 := "OANDA:XPTUSD"
        a3 := "OANDA:XCUUSD"
    else if k == "XAGUSD"
        a1 := "OANDA:XAUUSD"
        a2 := "OANDA:XPTUSD"
        a3 := "OANDA:XCUUSD"
    else if r == "GC" or r == "MGC"
        a1 := "COMEX:SI1!"
        a2 := "NYMEX:PL1!"
        a3 := "COMEX:HG1!"
    else if r == "SI" or r == "SIL"
        a1 := "COMEX:GC1!"
        a2 := "NYMEX:PL1!"
        a3 := "COMEX:HG1!"
    else if r == "ES"
        a1 := "CME_MINI:NQ1!"
        a2 := "CBOT_MINI:YM1!"
    else if r == "NQ"
        a1 := "CME_MINI:ES1!"
        a2 := "CBOT_MINI:YM1!"
    else if r == "YM"
        a1 := "CME_MINI:ES1!"
        a2 := "CME_MINI:NQ1!"
    else if r == "MES"
        a1 := "CME_MINI:MNQ1!"
        a2 := "CBOT_MINI:MYM1!"
    else if r == "MNQ"
        a1 := "CME_MINI:MES1!"
        a2 := "CBOT_MINI:MYM1!"
    else if r == "MYM"
        a1 := "CME_MINI:MES1!"
        a2 := "CME_MINI:MNQ1!"
    else if k == "EURUSD"
        a1 := "OANDA:GBPUSD"
    else if k == "GBPUSD"
        a1 := "OANDA:EURUSD"
    else if k == "BTCUSD" or k == "BTCUSDT"
        a1 := "BINANCE:ETHUSDT"
    else if k == "ETHUSD" or k == "ETHUSDT"
        a1 := "BINANCE:BTCUSDT"
    [a1, a2, a3]

[auto1, auto2, auto3] = autoPairs()
string sym1 = smt1In != "" ? smt1In : auto1
string sym2 = smt2In != "" ? smt2In : auto2
string sym3 = smt3In != "" ? smt3In : auto3
bool   on1  = showSMT and use1 and sym1 != ""
bool   on2  = showSMT and use2 and sym2 != ""
bool   on3  = showSMT and use3 and sym3 != ""

symName(string sym) =>
    str.contains(sym, ":") ? str.substring(sym, str.pos(sym, ":") + 1) : sym

reqHL(string sym, bool on, bool inv) =>
    [h, l] = request.security(on ? sym : syminfo.tickerid, timeframe.period, [high, low])
    [inv ? -l : h, inv ? -h : l]

[h1, l1] = reqHL(sym1, on1, inv1)
[h2, l2] = reqHL(sym2, on2, inv2)
[h3, l3] = reqHL(sym3, on3, inv3)

type Smt
    int          cid
    int          q
    float        aH
    float        aL
    int          aHT
    int          aLT
    float        pAH
    float        pAL
    int          pAHT
    int          pALT
    array<float> bH
    array<float> bL
    array<float> pBH
    array<float> pBL
    bool         bearDone = false
    bool         bullDone = false
    int          qn = 0
    bool         bearOn = false
    bool         bullOn = false
    int          bearEvT
    int          bullEvT
    int          bearEvQn
    int          bullEvQn
    int          prevBearEvT
    int          prevBullEvT
    int          prevBearEvQn
    int          prevBullEvQn
    line         lastBearLn
    label        lastBearLb
    line         lastBullLn
    label        lastBullLb
    int          lastBearEnd
    int          lastBullEnd
    line         bearLn
    label        bearLb
    line         bullLn
    label        bullLb

var Smt sm = Smt.new(bH = array.new<float>(3, na), bL = array.new<float>(3, na), pBH = array.new<float>(3, na), pBL = array.new<float>(3, na))
bool newBearSmt = false
bool newBullSmt = false
bool curBear    = false
bool curBull    = false
int  curNeed    = 0

fmtP(float v) =>
    na(v) ? "-" : str.tostring(v, "#.#####")

array<bool>   onArr = array.from(on1, on2, on3)
array<float>  hiArr = array.from(h1, h2, h3)
array<float>  loArr = array.from(l1, l2, l3)
array<string> nmArr = array.from(symName(sym1), symName(sym2), symName(sym3))

if showSMT and not na(bId)
    if na(sm.cid) or bId != sm.cid or bQ != sm.q
        // New quarter. SMTs that were standing when the last quarter ended stay on record.
        sm.qn     += 1
        sm.bearOn := false
        sm.bullOn := false
        // The finished quarter becomes the reference
        sm.pAH  := sm.aH
        sm.pAL  := sm.aL
        sm.pAHT := sm.aHT
        sm.pALT := sm.aLT
        sm.aH   := high
        sm.aL   := low
        sm.aHT  := time
        sm.aLT  := time
        for i = 0 to 2
            sm.pBH.set(i, sm.bH.get(i))
            sm.pBL.set(i, sm.bL.get(i))
            sm.bH.set(i, hiArr.get(i))
            sm.bL.set(i, loArr.get(i))
        sm.bearDone := false
        sm.bullDone := false
        sm.bearLn := na
        sm.bearLb := na
        sm.bullLn := na
        sm.bullLb := na
    else
        if high > sm.aH
            sm.aH  := high
            sm.aHT := time
        if low < sm.aL
            sm.aL  := low
            sm.aLT := time
        for i = 0 to 2
            float h = hiArr.get(i)
            float l = loArr.get(i)
            float ch = sm.bH.get(i)
            float cl = sm.bL.get(i)
            sm.bH.set(i, na(ch) ? h : na(h) ? ch : math.max(ch, h))
            sm.bL.set(i, na(cl) ? l : na(l) ? cl : math.min(cl, l))
    sm.cid := bId
    sm.q   := bQ

    if not na(sm.pAH)
        bool aUp = sm.aH > sm.pAH
        bool aDn = sm.aL < sm.pAL
        string bearWho = ""
        string bullWho = ""
        string bearDet = syminfo.ticker + ": prev Q high " + fmtP(sm.pAH) + ", this Q " + fmtP(sm.aH) + (aUp ? " -> TOOK IT" : " -> not taken")
        string bullDet = syminfo.ticker + ": prev Q low " + fmtP(sm.pAL) + ", this Q " + fmtP(sm.aL) + (aDn ? " -> TOOK IT" : " -> not taken")
        int nValid = 0
        int nBear  = 0
        int nBull  = 0
        for i = 0 to 2
            if onArr.get(i) and not na(sm.pBH.get(i)) and not na(sm.bH.get(i))
                nValid += 1
                bool bUp = sm.bH.get(i) > sm.pBH.get(i)
                bool bDn = sm.bL.get(i) < sm.pBL.get(i)
                bearDet += "\n" + nmArr.get(i) + ": prev Q high " + fmtP(sm.pBH.get(i)) + ", this Q " + fmtP(sm.bH.get(i)) + (bUp ? " -> TOOK IT" : " -> not taken")
                bullDet += "\n" + nmArr.get(i) + ": prev Q low " + fmtP(sm.pBL.get(i)) + ", this Q " + fmtP(sm.bL.get(i)) + (bDn ? " -> TOOK IT" : " -> not taken")
                if (sm.bH.get(i) > sm.pBH.get(i)) != aUp
                    nBear += 1
                    bearWho := bearWho + (bearWho == "" ? "" : ", ") + nmArr.get(i)
                if (sm.bL.get(i) < sm.pBL.get(i)) != aDn
                    nBull += 1
                    bullWho := bullWho + (bullWho == "" ? "" : ", ") + nmArr.get(i)
        int  need = math.min(smtMin, nValid)
        bool bear = nValid > 0 and nBear >= need
        bool bull = nValid > 0 and nBull >= need
        curBear := bear
        curBull := bull
        curNeed := need

        // Bearish: a straight line joining the previous quarter high and this quarter's high
        if bear and not sm.bearOn
            // A bearish SMT has formed (the event is recorded whether or not it is drawn)
            if not sm.bearDone
                newBearSmt := true
            sm.bearDone := true
            sm.bearOn   := true
            sm.prevBearEvT  := sm.bearEvT
            sm.prevBearEvQn := sm.bearEvQn
            sm.bearEvT  := time
            sm.bearEvQn := sm.qn
            if bDraw
                // A run of SMTs sharing a high: keep only the newest line
                if sm.lastBearEnd == sm.pAHT and not na(sm.lastBearLn)
                    sm.lastBearLn.delete()
                    sm.lastBearLb.delete()
                sm.bearLn := line.new(sm.pAHT, sm.pAH, sm.aHT, sm.aH, xloc.bar_time, color = smtBearC, width = 2)
                sm.bearLb := label.new(sm.aHT, sm.aH, "SMT", xloc.bar_time, color = color(na), style = label.style_label_down, textcolor = smtBearC, size = size.small, tooltip = (aUp ? syminfo.ticker + " took the previous quarter high. Did not: " + bearWho : bearWho + " took the previous quarter high. " + syminfo.ticker + " did not.") + "\n\n" + bearDet)
                sm.lastBearLn  := sm.bearLn
                sm.lastBearLb  := sm.bearLb
                sm.lastBearEnd := sm.aHT
        else if bear and sm.bearOn
            if not na(sm.bearLn)
                sm.bearLn.set_xy2(sm.aHT, sm.aH)
                sm.bearLb.set_xy(sm.aHT, sm.aH)
                sm.bearLb.set_tooltip((aUp ? syminfo.ticker + " took the previous quarter high. Did not: " + bearWho : bearWho + " took the previous quarter high. " + syminfo.ticker + " did not.") + "\n\n" + bearDet)
                sm.lastBearEnd := sm.aHT
        else if not bear and sm.bearOn and smtRemove
            // The other symbols caught up: this SMT no longer stands
            sm.bearOn   := false
            sm.bearEvT  := sm.prevBearEvT
            sm.bearEvQn := sm.prevBearEvQn
            if not na(sm.bearLn)
                sm.bearLn.delete()
                sm.bearLb.delete()
                sm.bearLn := na
                sm.bearLb := na
                sm.lastBearLn  := na
                sm.lastBearLb  := na
                sm.lastBearEnd := na

        // Bullish: a straight line joining the previous quarter low and this quarter's low
        if bull and not sm.bullOn
            // A bullish SMT has formed (the event is recorded whether or not it is drawn)
            if not sm.bullDone
                newBullSmt := true
            sm.bullDone := true
            sm.bullOn   := true
            sm.prevBullEvT  := sm.bullEvT
            sm.prevBullEvQn := sm.bullEvQn
            sm.bullEvT  := time
            sm.bullEvQn := sm.qn
            if bDraw
                // A run of SMTs sharing a low: keep only the newest line
                if sm.lastBullEnd == sm.pALT and not na(sm.lastBullLn)
                    sm.lastBullLn.delete()
                    sm.lastBullLb.delete()
                sm.bullLn := line.new(sm.pALT, sm.pAL, sm.aLT, sm.aL, xloc.bar_time, color = smtBullC, width = 2)
                sm.bullLb := label.new(sm.aLT, sm.aL, "SMT", xloc.bar_time, color = color(na), style = label.style_label_up, textcolor = smtBullC, size = size.small, tooltip = (aDn ? syminfo.ticker + " took the previous quarter low. Did not: " + bullWho : bullWho + " took the previous quarter low. " + syminfo.ticker + " did not.") + "\n\n" + bullDet)
                sm.lastBullLn  := sm.bullLn
                sm.lastBullLb  := sm.bullLb
                sm.lastBullEnd := sm.aLT
        else if bull and sm.bullOn
            if not na(sm.bullLn)
                sm.bullLn.set_xy2(sm.aLT, sm.aL)
                sm.bullLb.set_xy(sm.aLT, sm.aL)
                sm.bullLb.set_tooltip((aDn ? syminfo.ticker + " took the previous quarter low. Did not: " + bullWho : bullWho + " took the previous quarter low. " + syminfo.ticker + " did not.") + "\n\n" + bullDet)
                sm.lastBullEnd := sm.aLT
        else if not bull and sm.bullOn and smtRemove
            // The other symbols caught up: this SMT no longer stands
            sm.bullOn   := false
            sm.bullEvT  := sm.prevBullEvT
            sm.bullEvQn := sm.prevBullEvQn
            if not na(sm.bullLn)
                sm.bullLn.delete()
                sm.bullLb.delete()
                sm.bullLn := na
                sm.bullLb := na
                sm.lastBullLn  := na
                sm.lastBullLb  := na
                sm.lastBullEnd := na

alertcondition(newBearSmt, "Bearish SMT", "Bearish quarterly SMT on {{ticker}}")
alertcondition(newBullSmt, "Bullish SMT", "Bullish quarterly SMT on {{ticker}}")

// ───────────────────────────── SMT check table ─────────────────────────────

var table smtTbl = table.new(position.bottom_right, 7, 6, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)

tCell(int c, int r, string s, color col) =>
    table.cell(smtTbl, c, r, s, text_color = col, text_size = size.small)

tRow(int r, string nm, bool on, float pH, float h, float pL, float l) =>
    bool ok = on and not na(pH) and not na(h)
    tCell(0, r, nm, color.white)
    tCell(1, r, ok ? fmtP(pH) : "-", color.silver)
    tCell(2, r, ok ? fmtP(h) : "-", color.silver)
    tCell(3, r, not on ? "off" : not ok ? "-" : h > pH ? "YES" : "no", ok and h > pH ? smtBearC : color.gray)
    tCell(4, r, ok ? fmtP(pL) : "-", color.silver)
    tCell(5, r, ok ? fmtP(l) : "-", color.silver)
    tCell(6, r, not on ? "off" : not ok ? "-" : l < pL ? "YES" : "no", ok and l < pL ? smtBullC : color.gray)

if barstate.islast and showSMT and showSmtTbl and not na(bId)
    array<string> hdr = array.from(bc + " quarter", "Prev Q high", "This Q high", "Took high", "Prev Q low", "This Q low", "Took low")
    for c = 0 to 6
        tCell(c, 0, hdr.get(c), color.white)
    tRow(1, syminfo.ticker, true, sm.pAH, sm.aH, sm.pAL, sm.aL)
    for i = 0 to 2
        tRow(i + 2, nmArr.get(i) + (i == 0 and inv1 or i == 1 and inv2 or i == 2 and inv3 ? " (inv)" : ""), onArr.get(i), sm.pBH.get(i), sm.bH.get(i), sm.pBL.get(i), sm.bL.get(i))
    tCell(0, 5, "SMT (needs " + str.tostring(curNeed) + ")", color.white)
    tCell(3, 5, curBear ? "BEARISH" : "none", curBear ? smtBearC : color.gray)
    tCell(6, 5, curBull ? "BULLISH" : "none", curBull ? smtBullC : color.gray)

// ───────────────────────────── Trend bias ─────────────────────────────
// Next two cycles up from the one on the chart supply the true opens.

Cycle p1 = switch bc
    "90 Minute"    => cS
    "Session (6H)" => cD
    "Daily"        => cW
    "Weekly"       => cM
    => cY
Cycle p2 = switch bc
    "90 Minute"    => cD
    "Session (6H)" => cW
    "Daily"        => cM
    => cY
bool oneTO = bc == "Monthly" or bc == "Yearly" or bc == "Off"
string p2Fallback = bc == "90 Minute" ? "TDO" : bc == "Session (6H)" ? "TWO" : bc == "Daily" ? "TMO" : "TYO"
string p1Fallback = bc == "90 Minute" ? "Session TO" : bc == "Session (6H)" ? "TDO" : bc == "Daily" ? "TWO" : bc == "Weekly" ? "TMO" : "TYO"

sideOf(float px) =>
    na(px) ? 0 : close > px ? 1 : close < px ? -1 : 0

int s1      = sideOf(p1.toPx)
int s2      = oneTO ? 0 : sideOf(p2.toPx)
// Quarter structure: the last two finished quarters of the chart's cycle
var float stH  = na
var float stL  = na
var float stPH = na
var float stPL = na
var float stPPH = na
var float stPPL = na
var int   stId = na
var int   stQ  = na
if not na(bId)
    if na(stId) or bId != stId or bQ != stQ
        stPPH := stPH
        stPPL := stPL
        stPH  := stH
        stPL  := stL
        stH   := high
        stL   := low
    else
        stH := math.max(stH, high)
        stL := math.min(stL, low)
    stId := bId
    stQ  := bQ
int s4 = na(stPPH) ? 0 : stPH < stPPH and stPL < stPPL ? -1 : stPH > stPPH and stPL > stPPL ? 1 : 0

// SMT only counts while it is fresh: formed in this quarter or the one just finished
// Latest SMT = the most recent one still standing, by the time it formed
bool hasBear  = not na(sm.bearEvT)
bool hasBull  = not na(sm.bullEvT)
int  smtDir   = hasBear and (not hasBull or sm.bearEvT > sm.bullEvT) ? -1 : hasBull ? 1 : 0
int  smtQn    = smtDir == -1 ? sm.bearEvQn : smtDir == 1 ? sm.bullEvQn : na
int  smtAge   = na(smtQn) ? 99 : sm.qn - smtQn
bool smtFresh = smtAge <= 1
int  s3       = showSMT and smtFresh ? smtDir : 0
int  score    = s1 + s2 + s3 + s4
int bias    = score >= 2 ? 1 : score <= -2 ? -1 : 0

bgcolor(showBias and biasBg ? (bias == 1 ? color.new(biasBullC, 92) : bias == -1 ? color.new(biasBearC, 92) : na) : na)

bool biasChanged = bias != nz(bias[1]) and bar_index > 0
if showBias and biasMarks and biasChanged and bias != 0 and bDraw
    label.new(bar_index, bias == 1 ? low : high, bias == 1 ? "BUYS" : "SELLS", color = bias == 1 ? biasBullC : biasBearC, style = bias == 1 ? label.style_label_up : label.style_label_down, textcolor = color.white, size = size.tiny)

alertcondition(biasChanged and bias == 1, "Bias turned bullish", "Quarterly Theory bias turned BULLISH on {{ticker}}: look for buys")
alertcondition(biasChanged and bias == -1, "Bias turned bearish", "Quarterly Theory bias turned BEARISH on {{ticker}}: look for sells")

var table biasTbl = table.new(position.top_right, 2, 6, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)

sideTxt(int sd) =>
    sd == 1 ? "price above" : sd == -1 ? "price below" : "not set yet"
sideCol(int sd) =>
    sd == 1 ? biasBullC : sd == -1 ? biasBearC : color.gray

if barstate.islast and showBias
    color bCol = bias == 1 ? biasBullC : bias == -1 ? biasBearC : color.gray
    table.cell(biasTbl, 0, 0, "BIAS", text_color = color.white, text_size = size.small)
    table.cell(biasTbl, 1, 0, bias == 1 ? "BULLISH - look for buys" : bias == -1 ? "BEARISH - look for sells" : "NEUTRAL - wait", text_color = color.white, bgcolor = color.new(bCol, 30), text_size = size.small)
    table.cell(biasTbl, 0, 1, (na(p1.toNm) ? p1Fallback : p1.toNm) + " " + fmtP(p1.toPx), text_color = color.silver, text_size = size.small)
    table.cell(biasTbl, 1, 1, sideTxt(s1), text_color = sideCol(s1), text_size = size.small)
    table.cell(biasTbl, 0, 2, oneTO ? "-" : (na(p2.toNm) ? p2Fallback : p2.toNm) + " " + fmtP(p2.toPx), text_color = color.silver, text_size = size.small)
    table.cell(biasTbl, 1, 2, oneTO ? "-" : sideTxt(s2), text_color = sideCol(s2), text_size = size.small)
    table.cell(biasTbl, 0, 3, "Quarter structure", text_color = color.silver, text_size = size.small)
    table.cell(biasTbl, 1, 3, s4 == 1 ? "higher highs + lows" : s4 == -1 ? "lower highs + lows" : "mixed", text_color = sideCol(s4), text_size = size.small)
    string smtAgeTxt = smtAge == 0 ? " (this quarter)" : smtAge == 1 ? " (last quarter)" : " (" + str.tostring(smtAge) + " quarters ago, ignored)"
    string smtTxt = not showSMT ? "off" : smtDir == 0 ? "none" : (smtDir == 1 ? "bullish" : "bearish") + smtAgeTxt
    table.cell(biasTbl, 0, 4, "Latest SMT", text_color = color.silver, text_size = size.small)
    table.cell(biasTbl, 1, 4, smtTxt, text_color = sideCol(s3), text_size = size.small)
    table.cell(biasTbl, 0, 5, "Score", text_color = color.silver, text_size = size.small)
    table.cell(biasTbl, 1, 5, (score > 0 ? "+" : "") + str.tostring(score) + " of 4 (needs +/-2)", text_color = bCol, text_size = size.small)
