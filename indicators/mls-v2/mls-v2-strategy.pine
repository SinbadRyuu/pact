//@version=6
strategy("PACT | MLS v2 Strategy | Liquidity Sweep Model", "MLS v2 S", overlay=true, max_boxes_count=200, max_lines_count=100, max_labels_count=150, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.2, process_orders_on_close=true, pyramiding=0)

// PACT Finance | MLS v2 Strategy
// Same rules as the MLS v2 indicator, wired to the Strategy Tester for backtesting.
// Commission is set to 0.20 per side per ounce (0.40 round trip). Change it under Properties.
// UK sessions use Europe/London; NY sessions use America/New_York.
// Both time zones automatically handle daylight saving.

// =====================================================
// INPUTS
// Every input uses display.none so the settings never flood the status line.
// =====================================================

gGeneral = "01 | Display"
showDash = input.bool(true, "Dashboard", group=gGeneral, display=display.none)
dashPosIn = input.string("Top right", "Dashboard position", options=["Top right", "Bottom right", "Bottom left", "Top left"], group=gGeneral, display=display.none)
textSizeIn = input.string("Small", "Text size", options=["Tiny", "Small", "Normal"], group=gGeneral, display=display.none)
showSetups = input.bool(true, "Sweep and MSS markers", group=gGeneral, display=display.none)
hideFailed = input.bool(true, "Hide setups that never triggered", group=gGeneral, display=display.none, tooltip="Removes the sweep and MSS markers of setups that expired or were invalidated, so the chart only shows the live setup and the setups that became trades.")
showEntries = input.bool(true, "Entry markers", group=gGeneral, display=display.none)
showResults = input.bool(true, "Trade results (TP / SL hit)", group=gGeneral, display=display.none)
showLevels = input.bool(true, "Live setup levels (MSS trigger, invalidation)", group=gGeneral, display=display.none)
showLiq = input.bool(true, "Untaken liquidity levels", group=gGeneral, display=display.none, tooltip="Short lines at the right edge for the swing, session and prior day highs and lows that have not been swept yet.")
showSession = input.bool(false, "Shade tracked session", group=gGeneral, display=display.none)

gZones = "02 | HTF FVGs"
showZones = input.bool(true, "Show HTF FVGs", group=gZones, display=display.none)
zonesPerSide = input.int(2, "Nearest zones per side", minval=1, maxval=10, group=gZones, display=display.none, tooltip="Only the closest live zones above and below price are drawn, plus any zone price is inside.")
zoneReach = input.float(3.0, "Only within (x HTF 1 ATR)", minval=0.5, step=0.5, group=gZones, display=display.none, tooltip="Zones and liquidity levels further than this from price are not drawn, so they can't squash the price scale. All zones are still used for A / B grading.")
showFilled = input.bool(false, "Also show filled / expired zones (faded)", group=gZones, display=display.none)
keepZones = input.int(12, "HTF FVGs to track", minval=2, maxval=60, group=gZones, display=display.none)

gLiq = "03 | Liquidity"
useSwings = input.bool(true, "Confirmed swings", group=gLiq, display=display.none)
useSession = input.bool(true, "Previous session", group=gLiq, display=display.none)
useDay = input.bool(true, "Previous day", group=gLiq, display=display.none)
sessionName = input.string("Asia", "Tracked session", options=["Asia", "London", "New York AM", "New York PM"], group=gLiq, display=display.none)
swingInput = input.int(0, "Pivot length (0 = auto)", minval=0, maxval=30, group=gLiq, display=display.none)

gTime = "04 | Sessions"
asia = input.session("0000-0600", "Asia | UK time", group=gTime, display=display.none)
london = input.session("0700-1000", "London | UK time", group=gTime, display=display.none)
nyAm = input.session("0830-1100", "NY AM | NY time", group=gTime, display=display.none)
nyPm = input.session("1330-1600", "NY PM | NY time", group=gTime, display=display.none)

gQuality = "05 | Quality"
strictTap = input.bool(false, "Require HTF FVG tap (A setups only)", group=gQuality, display=display.none)
sweepAtr = input.float(0.03, "Sweep ATR", minval=0, step=0.01, group=gQuality, display=display.none)
mssBuffer = input.float(0.05, "MSS buffer ATR", minval=0, step=0.01, group=gQuality, display=display.none)
mssBody = input.float(0.30, "MSS body ATR", minval=0, step=0.05, group=gQuality, display=display.none)
fvgSize = input.float(0.10, "Entry FVG ATR", minval=0, step=0.05, group=gQuality, display=display.none)
htfSize = input.float(0.10, "HTF FVG ATR", minval=0, step=0.05, group=gQuality, display=display.none)
maxMss = input.int(15, "Maximum bars to MSS", minval=1, maxval=150, group=gQuality, display=display.none)
maxFvg = input.int(18, "Maximum bars to retest", minval=1, maxval=150, group=gQuality, display=display.none)
maxHtfAge = input.int(24, "HTF zone age (HTF bars)", minval=1, maxval=200, group=gQuality, display=display.none)
usePD = input.bool(false, "Premium / discount filter (prior day 50%)", group=gQuality, display=display.none)

gFilter = "06 | Filters and costs"
useKillzone = input.bool(false, "Only take sweeps in London / NY AM", group=gFilter, display=display.none, tooltip="Uses the London and NY AM times from the Sessions group. Ignored above 1H.")
useTrend = input.bool(false, "Trade with HTF 2 trend (close vs 50 EMA, not drawn)", group=gFilter, display=display.none)
useBe = input.bool(false, "Move stop to breakeven at 1R", group=gFilter, display=display.none)
costPts = input.float(0.40, "Spread + commission per trade (price)", minval=0, step=0.05, group=gFilter, display=display.none, tooltip="Gold on OANDA is roughly 0.3 to 0.5. Every result is reduced by this.")
minStopPts = input.float(0.0, "Minimum stop size (price)", minval=0, step=0.5, group=gFilter, display=display.none, tooltip="Skip trades whose stop is so small the spread eats the edge. Try 3 to 5 on 1m to 5m.")

gPlan = "07 | Trade plan"
showPlan = input.bool(true, "Draw trade plans", group=gPlan, display=display.none)
rr = input.float(2.0, "Reward / risk", minval=0.5, maxval=10, step=0.5, group=gPlan, display=display.none)
stopAtr = input.float(0.12, "Stop buffer ATR", minval=0, step=0.02, group=gPlan, display=display.none)
minRisk = input.float(0.20, "Minimum risk ATR", minval=0.05, step=0.05, group=gPlan, display=display.none)
maxRisk = input.float(5.0, "Maximum risk ATR", minval=0.25, step=0.25, group=gPlan, display=display.none)
planLength = input.int(20, "Plan box length", minval=3, maxval=300, group=gPlan, display=display.none)
planFill = input.int(65, "Plan box transparency", minval=0, maxval=95, group=gPlan, display=display.none)
labelGap = input.int(3, "Label distance right of plan (bars)", minval=0, maxval=50, group=gPlan, display=display.none)
keepPlans = input.int(4, "Plans to retain", minval=1, maxval=10, group=gPlan, display=display.none)

gColors = "08 | Colours"
bullColor = input.color(#25d4bd, "Bullish signals", group=gColors, display=display.none)
bearColor = input.color(#ff687d, "Bearish signals", group=gColors, display=display.none)
fvgBullColor = input.color(#4fa6ff, "HTF bull FVG", group=gColors, display=display.none)
fvgBearColor = input.color(#ff9800, "HTF bear FVG", group=gColors, display=display.none)
liqColor = input.color(#b2b5be, "Liquidity levels", group=gColors, display=display.none)
tpColor = input.color(#00e676, "Take profit", group=gColors, display=display.none)
slColor = input.color(#ff1744, "Stop loss", group=gColors, display=display.none)
sessionColor = input.color(#4fa6ff, "Session shade", group=gColors, display=display.none)

string txtSize = textSizeIn == "Tiny" ? size.tiny : textSizeIn == "Normal" ? size.normal : size.small
string dashPos = dashPosIn == "Bottom right" ? position.bottom_right : dashPosIn == "Bottom left" ? position.bottom_left : dashPosIn == "Top left" ? position.top_left : position.top_right

// =====================================================
// HELPERS
// =====================================================

// HTF zones are stored as data and only drawn on the last bar,
// so far-away zones never stretch the price scale.
type Zone
    float top
    float bottom
    int dir
    int leftTime
    int rightTime
    int expires
    string tf
    bool dashed
    bool live = true

type Trade
    int dir
    float entry
    float stop
    float target
    float risk
    bool be = false

fPrice(float x) =>
    str.tostring(x, format.mintick)

fTfName(string tf) =>
    tf == "60" ? "1H" : tf == "240" ? "4H" : tf

// Runs on the higher timeframe. Candles [3], [2], [1] are closed, so nothing repaints.
fHtf(float threshold) =>
    float a = ta.atr(14)
    bool bull = low[1] > high[3] and low[1] - high[3] >= a[1] * threshold
    bool bear = high[1] < low[3] and low[3] - high[1] >= a[1] * threshold
    [bull ? low[1] : na, bull ? high[3] : na, bear ? low[3] : na, bear ? high[1] : na, time[2], time, a[1]]

fAddZone(array<Zone> zs, int dir, float top, float bottom, int leftTime, int expires, string tf, bool dashed) =>
    zs.push(Zone.new(top, bottom, dir, leftTime, time_close, expires, fTfName(tf), dashed))
    if zs.size() > keepZones
        zs.shift()

// A zone dies when a candle closes through it or it gets too old.
fUpdateZones(array<Zone> zs) =>
    for z in zs
        if z.live
            bool filled = z.dir == 1 ? close < z.bottom : close > z.top
            if filled or time > z.expires
                z.live := false
            z.rightTime := time_close

fTouch(array<Zone> zs, int dir, float h, float l) =>
    bool hit = false
    for z in zs
        if z.live and z.dir == dir and h >= z.bottom and l <= z.top
            hit := true
    hit

fDrawZone(Zone z, int liveRight) =>
    color c = z.dir == 1 ? fvgBullColor : fvgBearColor
    box.new(z.leftTime, z.top, z.live ? liveRight : z.rightTime, z.bottom, xloc=xloc.bar_time, bgcolor=color.new(c, z.live ? 86 : 95), border_color=color.new(c, z.live ? 45 : 82), border_style=z.dashed ? line.style_dashed : line.style_solid, text=z.tf + (z.dir == 1 ? " bull FVG" : " bear FVG"), text_color=color.new(c, z.live ? 10 : 60), text_size=size.tiny, text_halign=text.align_right, text_valign=text.align_center)

// =====================================================
// ADAPTIVE TIMEFRAMES
// =====================================================

int sec = nz(timeframe.in_seconds(), 60)
int pivotLen = swingInput > 0 ? swingInput : sec <= 300 ? 5 : sec <= 3600 ? 4 : 3
int internalLen = math.max(2, pivotLen - 2)

string htf1 = sec < 3600 ? "60" : sec < 14400 ? "240" : sec < 86400 ? "D" : sec < 604800 ? "W" : sec < 2592000 ? "M" : sec < 7776000 ? "3M" : "12M"
string htf2 = sec < 3600 ? "240" : sec < 14400 ? "D" : sec < 86400 ? "W" : sec < 604800 ? "M" : sec < 2592000 ? "3M" : "12M"

bool valid1 = timeframe.in_seconds(htf1) > sec
bool valid2 = timeframe.in_seconds(htf2) > sec

[t1, b1, st1, sb1, left1, event1, htfAtr] = request.security(syminfo.tickerid, htf1, fHtf(htfSize), lookahead=barmerge.lookahead_on)
[t2, b2, st2, sb2, left2, event2, htfAtr2] = request.security(syminfo.tickerid, htf2, fHtf(htfSize), lookahead=barmerge.lookahead_on)
[dayHi, dayLo] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
bool trendUp = request.security(syminfo.tickerid, htf2, close[1] > ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)

bool dayUsable = sec < 86400

int age1 = maxHtfAge * timeframe.in_seconds(htf1) * 1000
int age2 = maxHtfAge * timeframe.in_seconds(htf2) * 1000

// =====================================================
// TIME ZONES AND SESSIONS
// =====================================================

string sess = sessionName == "Asia" ? asia : sessionName == "London" ? london : sessionName == "New York AM" ? nyAm : nyPm
string tz = sessionName == "New York AM" or sessionName == "New York PM" ? "America/New_York" : "Europe/London"
string sessShort = sessionName == "New York AM" ? "NY AM" : sessionName == "New York PM" ? "NY PM" : sessionName

bool sessionUsable = useSession and timeframe.isintraday and sec <= 3600
bool inSession = sessionUsable and not na(time(timeframe.period, sess, tz))
bool inKillzone = not na(time(timeframe.period, london, "Europe/London")) or not na(time(timeframe.period, nyAm, "America/New_York"))

var float currentSessionHi = na
var float currentSessionLo = na
var float previousSessionHi = na
var float previousSessionLo = na

// =====================================================
// STRUCTURE
// =====================================================

float atr = ta.atr(14)
float ph = ta.pivothigh(high, pivotLen, pivotLen)
float pl = ta.pivotlow(low, pivotLen, pivotLen)
float ih = ta.pivothigh(high, internalLen, internalLen)
float il = ta.pivotlow(low, internalLen, internalLen)

// Fallback structure: the extreme of the leg into the sweep
float legHi = ta.highest(high, pivotLen * 3)[1]
float legLo = ta.lowest(low, pivotLen * 3)[1]

var float lastHi = na
var float lastLo = na
var float lastInternalHi = na
var float lastInternalLo = na

// Higher timeframe zones

var array<Zone> zones = array.new<Zone>()
var int lastBull1 = na
var int lastBear1 = na
var int lastBull2 = na
var int lastBear2 = na

// Setup state

var int stage = 0
var int direction = 0
var int sweepIndex = na
var float extreme = na
var string sweptName = ""
var float sweptLevel = na
var bool touchedHtf = false
var float structureLevel = na
var int mssIndex = na

var float gapTop = na
var float gapBottom = na
var int gapIndex = na

var int entryCount = 0

// Markers of the setup in progress. They are kept if it becomes a trade.
var label setupSweepLbl = na
var label setupMssLbl = na
var array<label> chainLabels = array.new<label>()

// Levels already swept; liquidity that has been taken is not traded again
var float takenPsh = na
var float takenPsl = na
var float takenPdh = na
var float takenPdl = na

// Trade results
var array<Trade> trades = array.new<Trade>()
var int wins = 0
var int losses = 0
var int scratches = 0
var float netR = 0.0
bool tradeWin = false
bool tradeLoss = false
bool tradeBe = false

bool bullSweep = false
bool bearSweep = false
bool bullMss = false
bool bearMss = false
bool bullEntry = false
bool bearEntry = false

float entryPx = na
float stopPx = na
float targetPx = na

// =====================================================
// CONFIRMED CANDLE ENGINE
// =====================================================

if barstate.isconfirmed

    // Score open trades after costs. The stop is checked first, so a candle that hits both counts against you.
    if trades.size() > 0
        for i = trades.size() - 1 to 0
            Trade tr = trades.get(i)
            bool hitStop = tr.dir == 1 ? low <= tr.stop : high >= tr.stop
            bool hitTarget = tr.dir == 1 ? high >= tr.target : low <= tr.target
            float costR = costPts / tr.risk

            if hitStop
                if tr.be
                    scratches += 1
                    netR -= costR
                    tradeBe := true
                else
                    losses += 1
                    netR -= 1.0 + costR
                    tradeLoss := true
                trades.remove(i)
            else if hitTarget
                wins += 1
                netR += rr - costR
                tradeWin := true
                trades.remove(i)
            else if useBe and not tr.be and (tr.dir == 1 ? high >= tr.entry + tr.risk : low <= tr.entry - tr.risk)
                tr.be := true
                tr.stop := tr.entry

    // New HTF FVGs
    if valid1
        if not na(t1) and (na(lastBull1) or event1 != lastBull1)
            fAddZone(zones, 1, t1, b1, left1, event1 + age1, htf1, false)
            lastBull1 := event1

        if not na(st1) and (na(lastBear1) or event1 != lastBear1)
            fAddZone(zones, -1, st1, sb1, left1, event1 + age1, htf1, false)
            lastBear1 := event1

    if valid2
        if not na(t2) and (na(lastBull2) or event2 != lastBull2)
            fAddZone(zones, 1, t2, b2, left2, event2 + age2, htf2, true)
            lastBull2 := event2

        if not na(st2) and (na(lastBear2) or event2 != lastBear2)
            fAddZone(zones, -1, st2, sb2, left2, event2 + age2, htf2, true)
            lastBear2 := event2

    // Completed session range
    if sessionUsable
        if inSession and not inSession[1]
            currentSessionHi := high
            currentSessionLo := low
        else if inSession
            currentSessionHi := math.max(nz(currentSessionHi, high), high)
            currentSessionLo := math.min(nz(currentSessionLo, low), low)

        if not inSession and inSession[1]
            previousSessionHi := currentSessionHi
            previousSessionLo := currentSessionLo

    // Liquidity sweeps
    bool highSweep = false
    bool lowSweep = false
    string highName = ""
    string lowName = ""
    float highLevel = na
    float lowLevel = na

    float penetration = math.max(syminfo.mintick, nz(atr, high - low) * sweepAtr)

    if useSwings and not na(lastHi) and high > lastHi + penetration and close < lastHi and close[1] <= lastHi
        highSweep := true
        highName := "Swing H"
        highLevel := lastHi
        lastHi := na

    if useSwings and not na(lastLo) and low < lastLo - penetration and close > lastLo and close[1] >= lastLo
        lowSweep := true
        lowName := "Swing L"
        lowLevel := lastLo
        lastLo := na

    if sessionUsable and not na(previousSessionHi) and (na(takenPsh) or previousSessionHi != takenPsh) and high > previousSessionHi + penetration and close < previousSessionHi and close[1] <= previousSessionHi
        highSweep := true
        highName := sessShort + " H"
        highLevel := previousSessionHi
        takenPsh := previousSessionHi

    if sessionUsable and not na(previousSessionLo) and (na(takenPsl) or previousSessionLo != takenPsl) and low < previousSessionLo - penetration and close > previousSessionLo and close[1] >= previousSessionLo
        lowSweep := true
        lowName := sessShort + " L"
        lowLevel := previousSessionLo
        takenPsl := previousSessionLo

    if useDay and dayUsable and not na(dayHi) and (na(takenPdh) or dayHi != takenPdh) and high > dayHi + penetration and close < dayHi and close[1] <= dayHi
        highSweep := true
        highName := "PDH"
        highLevel := dayHi
        takenPdh := dayHi

    if useDay and dayUsable and not na(dayLo) and (na(takenPdl) or dayLo != takenPdl) and low < dayLo - penetration and close > dayLo and close[1] >= dayLo
        lowSweep := true
        lowName := "PDL"
        lowLevel := dayLo
        takenPdl := dayLo

    if highSweep and lowSweep
        highSweep := false
        lowSweep := false

    bool setupFailed = false

    // Expiry and invalidation
    if stage != 0
        bool invalidated = direction == 1 ? close < extreme : close > extreme
        bool expired = stage == 1 ? bar_index - sweepIndex > maxMss : bar_index - mssIndex > maxFvg

        if invalidated or expired
            stage := 0
            direction := 0
            setupFailed := true

    // Three candle FVG
    bool bullGap = bar_index >= 2 and not na(atr) and low > high[2] and low - high[2] >= fvgSize * atr and close[1] > open[1]
    bool bearGap = bar_index >= 2 and not na(atr) and high < low[2] and low[2] - high >= fvgSize * atr and close[1] < open[1]

    if (stage == 1 or stage == 2) and bar_index > sweepIndex
        if (direction == 1 and bullGap) or (direction == -1 and bearGap)
            gapTop := direction == 1 ? low : low[2]
            gapBottom := direction == 1 ? high[2] : high
            gapIndex := bar_index

            if stage == 2
                stage := 3

    // Market structure shift
    if stage == 1 and bar_index > sweepIndex and not na(structureLevel) and not na(atr) and atr > 0
        bool bodyOk = math.abs(close - open) >= mssBody * atr
        bool directional = direction == 1 ? close > open : close < open
        bool broke = direction == 1 ? close > structureLevel + mssBuffer * atr : close < structureLevel - mssBuffer * atr

        if bodyOk and directional and broke
            bullMss := direction == 1
            bearMss := direction == -1
            mssIndex := bar_index
            stage := not na(gapTop) ? 3 : 2

            if showSetups
                setupMssLbl := label.new(bar_index, close, "MSS", yloc=direction == 1 ? yloc.belowbar : yloc.abovebar, style=direction == 1 ? label.style_label_up : label.style_label_down, color=color.new(direction == 1 ? bullColor : bearColor, 55), textcolor=color.white, size=size.tiny, tooltip="Market structure shift: closed " + (direction == 1 ? "above " : "below ") + fPrice(structureLevel))

    // Entry retest
    if stage == 3 and not na(gapTop) and bar_index > gapIndex and not na(atr) and atr > 0
        bool brokenGap = direction == 1 ? close < gapBottom : close > gapTop

        if brokenGap
            stage := 0
            setupFailed := true
        else
            bool touched = high >= gapBottom and low <= gapTop
            bool rejected = direction == 1 ? close > gapTop and close > open : close < gapBottom and close < open

            float proposedStop = direction == 1 ? extreme - stopAtr * atr : extreme + stopAtr * atr
            float risk = direction == 1 ? close - proposedStop : proposedStop - close
            bool acceptable = risk >= minRisk * atr and risk <= maxRisk * atr and risk >= minStopPts

            // One trade at a time
            if touched and rejected and acceptable and trades.size() == 0
                bullEntry := direction == 1
                bearEntry := direction == -1

                entryPx := math.round_to_mintick(close)
                stopPx := math.round_to_mintick(proposedStop)
                targetPx := math.round_to_mintick(close + direction * rr * risk)

                entryCount += 1
                trades.push(Trade.new(direction, entryPx, stopPx, targetPx, math.abs(entryPx - stopPx)))
                stage := 0

                // This setup became a trade, so its markers stay on the chart
                if not na(setupSweepLbl)
                    chainLabels.push(setupSweepLbl)
                if not na(setupMssLbl)
                    chainLabels.push(setupMssLbl)
                setupSweepLbl := na
                setupMssLbl := na
                while chainLabels.size() > keepPlans * 2
                    label.delete(chainLabels.shift())

    // A setup that died without a trade: remove or fade its markers
    if setupFailed
        if hideFailed
            if not na(setupSweepLbl)
                label.delete(setupSweepLbl)
            if not na(setupMssLbl)
                label.delete(setupMssLbl)
        else
            if not na(setupSweepLbl)
                label.set_color(setupSweepLbl, color.new(color.gray, 70))
            if not na(setupMssLbl)
                label.set_color(setupMssLbl, color.new(color.gray, 70))
        setupSweepLbl := na
        setupMssLbl := na

    // Arm a new setup
    if stage == 0 and (highSweep or lowSweep)
        int nextDir = lowSweep ? 1 : -1

        bool tap = fTouch(zones, nextDir, high, low)

        // The MSS level must sit on the far side of price, otherwise any candle would "break" it
        float internalLevel = nextDir == 1 ? lastInternalHi : lastInternalLo
        bool internalOk = not na(internalLevel) and (nextDir == 1 ? internalLevel > close : internalLevel < close)
        float targetStructure = internalOk ? internalLevel : nextDir == 1 ? legHi : legLo
        bool structureOk = not na(targetStructure) and (nextDir == 1 ? targetStructure > close : targetStructure < close)

        float dayMid = (dayHi + dayLo) / 2
        bool pdOk = not usePD or not dayUsable or na(dayMid) or (nextDir == 1 ? close < dayMid : close > dayMid)

        bool kzOk = not useKillzone or sec > 3600 or inKillzone
        bool trendOk = not useTrend or not valid2 or (nextDir == 1 ? trendUp : not trendUp)

        if (not strictTap or tap) and structureOk and pdOk and kzOk and trendOk
            stage := 1
            direction := nextDir
            sweepIndex := bar_index
            extreme := nextDir == 1 ? low : high
            sweptName := nextDir == 1 ? lowName : highName
            sweptLevel := nextDir == 1 ? lowLevel : highLevel
            touchedHtf := tap
            structureLevel := targetStructure
            mssIndex := na
            gapTop := na
            gapBottom := na
            gapIndex := na

            bullSweep := nextDir == 1
            bearSweep := nextDir == -1

            if showSetups
                string tip = "Swept " + sweptName + " " + fPrice(sweptLevel) + (tap ? " inside a live HTF FVG (A setup)" : " (B setup)") + ". MSS needs a close " + (nextDir == 1 ? "above " : "below ") + fPrice(targetStructure)
                setupSweepLbl := label.new(bar_index, close, sweptName + " sweep", yloc=nextDir == 1 ? yloc.belowbar : yloc.abovebar, style=nextDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(nextDir == 1 ? bullColor : bearColor, 20), textcolor=color.black, size=size.tiny, tooltip=tip)

    // Extend, fill or expire HTF FVGs after this candle has been used
    fUpdateZones(zones)

    // Update confirmed pivots last
    if not na(ph)
        lastHi := ph

    if not na(pl)
        lastLo := pl

    if not na(ih)
        lastInternalHi := ih

    if not na(il)
        lastInternalLo := il

// =====================================================
// STRATEGY ORDERS
// =====================================================

if bullEntry
    strategy.entry("Long", strategy.long)

if bearEntry
    strategy.entry("Short", strategy.short)

// Re-sent every bar so the breakeven move reaches the broker emulator
if trades.size() > 0
    Trade live = trades.first()
    strategy.exit(live.dir == 1 ? "Long exit" : "Short exit", live.dir == 1 ? "Long" : "Short", stop=live.stop, limit=live.target)

// =====================================================
// CHART PLOTS
// display.pane keeps marker values out of the status line.
// =====================================================

bgcolor(showSession and inSession ? color.new(sessionColor, 94) : na)

plotshape(showEntries and bullEntry, title="MLS buy", style=shape.triangleup, location=location.belowbar, color=color.lime, text="BUY", textcolor=color.lime, size=size.small, display=display.pane)
plotshape(showEntries and bearEntry, title="MLS sell", style=shape.triangledown, location=location.abovebar, color=color.red, text="SELL", textcolor=color.red, size=size.small, display=display.pane)

plotshape(showResults and tradeWin, title="TP hit", style=shape.circle, location=location.abovebar, color=tpColor, text="TP ✓", textcolor=tpColor, size=size.tiny, display=display.pane)
plotshape(showResults and tradeBe, title="Breakeven", style=shape.square, location=location.abovebar, color=color.gray, text="BE", textcolor=color.gray, size=size.tiny, display=display.pane)
plotshape(showResults and tradeLoss, title="SL hit", style=shape.xcross, location=location.belowbar, color=slColor, text="SL ✗", textcolor=slColor, size=size.tiny, display=display.pane)

// =====================================================
// LAST BAR DRAWINGS
// Zones, liquidity and the live setup are redrawn on the last bar only,
// and only near price, so the price scale stays tight around the candles.
// =====================================================

var array<box> zoneBoxes = array.new<box>()
var array<line> liqLines = array.new<line>()
var array<label> liqLabels = array.new<label>()
var line mssLine = na
var label mssLineLbl = na
var line invLine = na
var label invLineLbl = na
var box activeGap = na

float reach = zoneReach * nz(htfAtr, nz(atr, 0) * 6)

// Nearest untaken liquidity, used by the dashboard
float liqAbove = na
string liqAboveName = ""
float liqBelow = na
string liqBelowName = ""

if barstate.islast
    int liveRight = time_close + 6 * sec * 1000

    // HTF FVGs
    for b in zoneBoxes
        b.delete()
    zoneBoxes.clear()

    if showZones and zones.size() > 0
        array<float> upDist = array.new<float>()
        array<int> upIdx = array.new<int>()
        array<float> dnDist = array.new<float>()
        array<int> dnIdx = array.new<int>()

        for [i, z] in zones
            float d = z.bottom > close ? z.bottom - close : z.top < close ? close - z.top : 0.0
            if d <= reach
                if not z.live
                    if showFilled
                        zoneBoxes.push(fDrawZone(z, liveRight))
                else if z.bottom > close
                    upDist.push(d)
                    upIdx.push(i)
                else if z.top < close
                    dnDist.push(d)
                    dnIdx.push(i)
                else
                    zoneBoxes.push(fDrawZone(z, liveRight))

        if upDist.size() > 0
            array<int> order = upDist.sort_indices()
            for k = 0 to math.min(zonesPerSide, order.size()) - 1
                zoneBoxes.push(fDrawZone(zones.get(upIdx.get(order.get(k))), liveRight))

        if dnDist.size() > 0
            array<int> order = dnDist.sort_indices()
            for k = 0 to math.min(zonesPerSide, order.size()) - 1
                zoneBoxes.push(fDrawZone(zones.get(dnIdx.get(order.get(k))), liveRight))

    // Untaken liquidity: highs above price and lows below it
    array<float> lvPx = array.new<float>()
    array<string> lvName = array.new<string>()

    if useSwings
        lvPx.push(lastHi)
        lvName.push("Swing H")
        lvPx.push(lastLo)
        lvName.push("Swing L")

    if sessionUsable
        lvPx.push(previousSessionHi == takenPsh ? na : previousSessionHi)
        lvName.push(sessShort + " H")
        lvPx.push(previousSessionLo == takenPsl ? na : previousSessionLo)
        lvName.push(sessShort + " L")

    if useDay and dayUsable
        lvPx.push(dayHi == takenPdh ? na : dayHi)
        lvName.push("PDH")
        lvPx.push(dayLo == takenPdl ? na : dayLo)
        lvName.push("PDL")

    for l in liqLines
        l.delete()
    liqLines.clear()
    for lb in liqLabels
        lb.delete()
    liqLabels.clear()

    for [i, px] in lvPx
        bool isHigh = i % 2 == 0
        bool valid = not na(px) and (isHigh ? px > close : px < close)
        if valid
            if isHigh and (na(liqAbove) or px < liqAbove)
                liqAbove := px
                liqAboveName := lvName.get(i)
            if not isHigh and (na(liqBelow) or px > liqBelow)
                liqBelow := px
                liqBelowName := lvName.get(i)

            if showLiq and math.abs(px - close) <= reach
                liqLines.push(line.new(bar_index - 15, px, bar_index + 4, px, color=color.new(liqColor, 30), style=line.style_dotted, width=1))
                liqLabels.push(label.new(bar_index + 4, px, lvName.get(i) + " " + fPrice(px), style=label.style_label_left, color=color.new(color.black, 100), textcolor=liqColor, size=size.tiny, tooltip="Untaken liquidity. A sweep of this level can arm a " + (isHigh ? "short" : "long") + " setup."))

    // Live setup: MSS trigger and invalidation lines
    if not na(mssLine)
        line.delete(mssLine)
    if not na(mssLineLbl)
        label.delete(mssLineLbl)
    if not na(invLine)
        line.delete(invLine)
    if not na(invLineLbl)
        label.delete(invLineLbl)
    mssLine := na
    mssLineLbl := na
    invLine := na
    invLineLbl := na

    if showLevels and stage != 0
        color dc = direction == 1 ? bullColor : bearColor
        int x1 = math.max(0, sweepIndex)
        if stage == 1 and not na(structureLevel)
            mssLine := line.new(x1, structureLevel, bar_index + 4, structureLevel, color=dc, style=line.style_dashed, width=1)
            mssLineLbl := label.new(bar_index + 4, structureLevel, "MSS trigger " + fPrice(structureLevel), style=label.style_label_left, color=color.new(color.black, 100), textcolor=dc, size=size.tiny, tooltip="A body candle closing " + (direction == 1 ? "above" : "below") + " this line confirms the shift.")
        if not na(extreme)
            invLine := line.new(x1, extreme, bar_index + 4, extreme, color=color.new(slColor, 20), style=line.style_dotted, width=1)
            invLineLbl := label.new(bar_index + 4, extreme, "Invalid " + fPrice(extreme), style=label.style_label_left, color=color.new(color.black, 100), textcolor=slColor, size=size.tiny, tooltip="A close " + (direction == 1 ? "below" : "above") + " the sweep extreme cancels the setup.")

    // Active entry FVG
    if not na(activeGap)
        box.delete(activeGap)
        activeGap := na

    if stage == 3 and not na(gapTop)
        activeGap := box.new(math.max(0, gapIndex), gapTop, bar_index + 4, gapBottom, bgcolor=color.new(direction == 1 ? bullColor : bearColor, 80), border_color=direction == 1 ? bullColor : bearColor, text="ENTRY FVG", text_color=direction == 1 ? bullColor : bearColor, text_size=size.tiny)

// =====================================================
// FINITE TP / SL PLANS
// =====================================================

var array<box> plans = array.new<box>()
var array<line> planLines = array.new<line>()
var array<label> planLabels = array.new<label>()

if showPlan and (bullEntry or bearEntry) and not na(entryPx)
    int x1 = bar_index
    int x2 = bar_index + planLength

    box takeBox = box.new(x1, math.max(entryPx, targetPx), x2, math.min(entryPx, targetPx), bgcolor=color.new(tpColor, planFill), border_color=tpColor, border_width=1, text="TP " + fPrice(targetPx), text_color=color.white, text_size=txtSize, text_halign=text.align_right, text_valign=bullEntry ? text.align_top : text.align_bottom)

    box stopBox = box.new(x1, math.max(entryPx, stopPx), x2, math.min(entryPx, stopPx), bgcolor=color.new(slColor, planFill), border_color=slColor, border_width=1, text="SL " + fPrice(stopPx), text_color=color.white, text_size=txtSize, text_halign=text.align_right, text_valign=bullEntry ? text.align_bottom : text.align_top)

    line entryLine = line.new(x1, entryPx, x2, entryPx, color=color.white, style=line.style_dashed, width=1)

    string labelText = (bullEntry ? "LONG " : "SHORT ") + (touchedHtf ? "A" : "B") + " @ " + fPrice(entryPx) + "\nSL " + fPrice(stopPx) + "  TP " + fPrice(targetPx) + "  " + str.tostring(rr, "#.#") + "R"

    // Sits to the right of the plan so it never covers the candles.
    label entryLabel = label.new(x2 + labelGap, entryPx, labelText, style=label.style_label_left, color=color.new(bullEntry ? bullColor : bearColor, 15), textcolor=color.black, size=txtSize, textalign=text.align_left, tooltip="After " + sweptName + " sweep. A = sweep tapped a live HTF FVG, B = it did not.")

    array.push(plans, takeBox)
    array.push(plans, stopBox)
    array.push(planLines, entryLine)
    array.push(planLabels, entryLabel)

    while array.size(plans) > keepPlans * 2
        box.delete(array.shift(plans))

    while array.size(planLines) > keepPlans
        line.delete(array.shift(planLines))

    while array.size(planLabels) > keepPlans
        label.delete(array.shift(planLabels))

// =====================================================
// DASHBOARD
// Answers three questions: what is the setup, what price do I watch, how am I doing.
// =====================================================

var table dashboard = table.new(dashPos, 2, 6, bgcolor=color.new(#101722, 10), frame_color=color.new(#5d718e, 60), frame_width=1, border_color=color.new(#5d718e, 85), border_width=1)

fRow(int row, string key, string val, color valColor) =>
    table.cell(dashboard, 0, row, key, text_color=color.silver, text_size=txtSize, text_halign=text.align_left)
    table.cell(dashboard, 1, row, val, text_color=valColor, text_size=txtSize, text_halign=text.align_left)

if barstate.islast
    if showDash
        color dirColor = direction == 1 ? bullColor : bearColor
        string side = direction == 1 ? "Long" : "Short"
        string grade = touchedHtf ? "A" : "B"

        string setupText = stage == 0 ? "Scanning for a sweep" : side + " " + grade + " · " + sweptName + " swept"
        color setupColor = stage == 0 ? color.gray : dirColor

        string nextText = ""
        if stage == 0
            string up = na(liqAbove) ? "none" : liqAboveName + " " + fPrice(liqAbove)
            string dn = na(liqBelow) ? "none" : liqBelowName + " " + fPrice(liqBelow)
            nextText := "▲ " + up + "   ▼ " + dn
        else if stage == 1
            nextText := "MSS: close " + (direction == 1 ? "above " : "below ") + fPrice(structureLevel) + " (" + str.tostring(math.max(0, maxMss - (bar_index - sweepIndex))) + " bars left)"
        else if stage == 2
            nextText := "Wait for a " + (direction == 1 ? "bullish" : "bearish") + " FVG (" + str.tostring(math.max(0, maxFvg - (bar_index - mssIndex))) + " bars left)"
        else
            nextText := "Retest " + fPrice(gapBottom) + " – " + fPrice(gapTop) + " (" + str.tostring(math.max(0, maxFvg - (bar_index - mssIndex))) + " bars left)"

        string invText = stage == 0 ? "–" : "Close " + (direction == 1 ? "below " : "above ") + fPrice(extreme)

        string tradeText = "None open"
        color tradeColor = color.gray
        if trades.size() > 0
            Trade tr = trades.first()
            float liveR = (close - tr.entry) * tr.dir / tr.risk
            tradeText := (tr.dir == 1 ? "Long @ " : "Short @ ") + fPrice(tr.entry) + "  " + (liveR >= 0 ? "+" : "") + str.tostring(liveR, "#.##") + "R" + (tr.be ? "  (BE)" : "")
            tradeColor := liveR >= 0 ? tpColor : slColor

        string recordText = str.tostring(wins) + "W  " + str.tostring(losses) + "L" + (useBe ? "  " + str.tostring(scratches) + "BE" : "") + "  ·  " + (netR >= 0 ? "+" : "") + str.tostring(netR, "#.#") + "R net"

        string htfText = (valid1 ? fTfName(htf1) : "–") + " / " + (valid2 ? fTfName(htf2) : "–")

        fRow(0, "MLS v2 · " + timeframe.period, "HTF " + htfText, color.white)
        fRow(1, "Setup", setupText, setupColor)
        fRow(2, stage == 0 ? "Liquidity" : "Next", nextText, stage == 0 ? liqColor : color.yellow)
        fRow(3, "Invalid if", invText, stage == 0 ? color.gray : slColor)
        fRow(4, "Trade", tradeText, tradeColor)
        fRow(5, "Record", recordText, netR >= 0 ? tpColor : slColor)
    else
        table.clear(dashboard, 0, 0, 1, 5)

// =====================================================
// ALERTS
// =====================================================

if bullEntry or bearEntry
    string sideName = bullEntry ? "LONG" : "SHORT"
    string gradeName = touchedHtf ? "A" : "B"
    string message = "MLS " + sideName + " " + gradeName + " " + syminfo.ticker + " " + timeframe.period + " | ENTRY " + fPrice(entryPx) + " | SL " + fPrice(stopPx) + " | TP " + fPrice(targetPx)
    alert(message, alert.freq_once_per_bar_close)
